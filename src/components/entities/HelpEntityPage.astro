---
import Base from "../../layouts/Base.astro";
import AppShell from "../../components/AppShell.astro";
import { findRoute, titleOf } from "../../config/routes";
import { LOCALES, type Locale } from "../../i18n/locales";
import type { SearchableHelpTopic } from "../../lib/searchable-help";
import { resourcePath, type EntityLink } from "../../lib/resource-route";
import type { ReleaseServer } from "../../lib/release-server";
import "../../styles/catalog.css";
import "../../styles/help.css";


interface Props {
  topic: SearchableHelpTopic;
  locale: Locale;
  server?: ReleaseServer;
  canonical?: boolean;
  returnTo?: string;
  previous?: EntityLink;
  next?: EntityLink;
}
const { topic, locale, server = "intl", canonical = false, returnTo, previous, next } = Astro.props;
const sectionRoute = "/catalog/help";
const sectionRouteDefinition = findRoute(sectionRoute);
if (!sectionRouteDefinition) throw new Error(`Missing route definition for ${sectionRoute}`);
const sectionTitle = titleOf(sectionRouteDefinition, locale);
const canonicalHref = resourcePath({ server, locale, kind: "help", id: topic.id });
const route = canonical ? canonicalHref : `${sectionRoute}/${topic.id}`;
const seoTitleValues = Object.fromEntries(
  LOCALES.map((target) => {
    const category = topic.categoryTitles[target];
    return [
      target,
      [topic.titles[target], category && category !== topic.titles[target] ? category : "", sectionTitle]
        .filter(Boolean)
        .join(" / "),
    ];
  }),
) as Record<Locale, string>;
---

<Base
  publication={topic.publication}
  locale={locale}
  route={route}
  canonicalRoute={canonical ? canonicalHref : undefined}
  title={sectionTitle}
  titleKey={sectionRouteDefinition.titleKey}
  description={topic.descriptions[locale]}
  seoTitleValues={seoTitleValues}
  seoDescriptionValues={topic.descriptions}
>
  <AppShell
    locale={locale}
    route={sectionRoute}
    server={server}
    title={canonical ? topic.titles[locale] : sectionTitle}
    titleKey={canonical ? undefined : sectionRouteDefinition.titleKey}
    entity={
      canonical
        ? {
            title: topic.titles[locale],
            backHref: returnTo || resourcePath({ server, locale, kind: "help" }),
            previous,
            next,
          }
        : undefined
    }
  >
    <article class="page help-page help-topic-page">
      <header class="help-topic-header">
        {!canonical && <a class="button button--text" href={resourcePath({ server, locale, kind: "help" })}>{sectionTitle}</a>}
        {!canonical && <h1>{topic.titles[locale]}</h1>}
        {topic.categoryTitles[locale] && topic.categoryTitles[locale] !== topic.titles[locale] && (
          <p class="detail-description">{topic.categoryTitles[locale]}</p>
        )}
      </header>
      <p class="detail-long-copy">{topic.descriptions[locale]}</p>
    </article>
  </AppShell>
</Base>
