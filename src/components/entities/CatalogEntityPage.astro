---
import Base from "../../layouts/Base.astro";
import AppShell from "../AppShell.astro";
import { nativeMetaPublicationFor } from "../../server/native-meta-publication";
import { staticCatalogRelease } from "../../lib/static-catalog-source";
import { catalogConfig } from "../../config/catalog-labels";
import { findRoute, titleOf } from "../../config/routes";
import { LOCALES, type Locale } from "../../i18n/locales";
import {
  resourceKindForCollection,
  chartPath,
  resourcePath,
  type EntityLink,
  type ResourceKind,
} from "../../lib/resource-route";
import type { ReleaseServer } from "../../lib/release-server";
import type { SearchableCatalogPage } from "../../lib/searchable-catalog";
import "../../lit/catalog-screen";
import "../../styles/catalog.css";
import { renderCatalogPage } from "../../server/render-catalog";
import { catalogPageData } from "../../server/catalog-page-projector";
import { serializePageData } from "../../lib/page-data";
import { defaultSongTitle, songTitle } from "../../lib/song-display";
import { eventSongPayload } from "../../server/event-song-release";
import { eventStoryPayload } from "../../server/story-visibility";
import { CHART_PLAYBACK_DATA_ELEMENT_ID, type ChartPlaybackData } from "../../server/chart-playback-assets";

interface Props {
  page: SearchableCatalogPage;
  locale: Locale;
  server?: ReleaseServer;
  canonical?: boolean;
  returnTo?: string;
  previous?: EntityLink;
  next?: EntityLink;
  chartPage?: boolean;
  chartPlayback?: ChartPlaybackData;
  section?: string;
}
const { page, locale, server = "intl", canonical = false, returnTo, previous, next, chartPage = false, chartPlayback, section } = Astro.props;
const collectionRoute = findRoute(page.route);
if (!collectionRoute) throw new Error(`Missing route definition for ${page.route}`);
const sectionTitle = titleOf(collectionRoute, locale);
const kind = resourceKindForCollection(page.collection) as ResourceKind;
const parentHref = resourcePath({ server, locale, kind, id: page.id });
const canonicalHref = chartPage ? chartPath({ server, locale, id: page.id }) : parentHref;
const route = canonical ? canonicalHref : `${page.route}/${page.id}`;
const backHref = returnTo || (chartPage ? parentHref : resourcePath({ server, locale, kind }));
const seoTitleValues = Object.fromEntries(
  LOCALES.map((target) => {
    const localizedSection = titleOf(collectionRoute, target);
    const subtitle = page.subtitles[target];
    return [
      target,
      [page.titles[target], subtitle !== page.titles[target] && subtitle, localizedSection].filter(Boolean).join(" / "),
    ];
  }),
) as Record<Locale, string>;
const payload = await eventStoryPayload(await eventSongPayload(await catalogPageData(server, page.resource, page.id, locale, "full")));
const pageDataId=`catalog-page-${page.resource}-${page.id}`;
const nativeMetaReference = process.env.NATIVE_META_REFERENCE_RECEIPTS_JSON && page.resource === "songs"
  ? nativeMetaPublicationFor(await staticCatalogRelease(server))
  : undefined;
const screenConfig = catalogConfig({
  resource: page.resource,
  ...(nativeMetaReference ? { nativeMetaReference } : {}),
  locale,
  server,
  entityKind: kind,
  ...(canonical ? { entityId: page.id, entityContext: true } : {}),
  ...(chartPage ? { chartPage: true } : {}),
  aspectRatio: page.resource === "cards" ? "224 / 294" : "1",
});
const rendered = await renderCatalogPage(screenConfig,payload,locale,section);
const body = rendered.body;
// The title bar shows a song as the reader's default does; search and SEO keep the local title.
const displayTitle = page.resource === "songs" ? defaultSongTitle(page.titles, locale) : page.titles[locale];
const entity = canonical
  ? {
      title: displayTitle,
      titleLanguage: page.resource === "songs" ? songTitle(payload.item, locale).locale : locale,
      backHref,
      previous,
      next,
    }
  : undefined;
---

<Base
  publication={payload.item}
  locale={locale}
  route={route}
  canonicalRoute={canonical ? canonicalHref : undefined}
  noindex={chartPage || !!section}
  title={sectionTitle}
  titleKey={collectionRoute.titleKey}
  description={page.descriptions[locale]}
  seoTitleValues={seoTitleValues}
  seoDescriptionValues={page.descriptions}
  searchImage={page.image}
  searchTitle={page.titles[locale]}
>
  <AppShell
    locale={locale}
    route={page.route}
    server={server}
    title={canonical ? displayTitle : sectionTitle}
    titleKey={canonical ? undefined : collectionRoute.titleKey}
    entity={entity}
    appBar={rendered.appBar}
  >
    <script is:inline type="application/json" id={pageDataId} set:html={serializePageData(payload)}></script>
    {chartPlayback && <script is:inline type="application/json" id={CHART_PLAYBACK_DATA_ELEMENT_ID} set:html={JSON.stringify(chartPlayback)}></script>}
    <catalog-screen config={screenConfig} data-prerendered data-page-data={pageDataId} set:html={body}></catalog-screen>
  </AppShell>
</Base>
<script>
  import "../../lit/catalog-screen";
</script>
