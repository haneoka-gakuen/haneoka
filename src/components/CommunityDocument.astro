---
import Base from "../layouts/Base.astro";
import AppShell from "./AppShell.astro";
import { type Locale } from "../i18n/locales";
import { t } from "../i18n/messages";
import "../lit/community-workspace";
import "../styles/catalog.css";
import "../styles/community.css";
const { locale, path } = Astro.props as { locale: Locale; path?: string };
const mode = path || "feeds";
const route = `/community${path ? `/${path}` : ""}`;
const modeTitleKeys: Record<string, string> = {
  feeds: "communityPage.feedRecommended", latest: "communityPage.feedLatest", following: "communityPage.feedFollowing", mine: "communityPage.mine", bookmarks: "communityPage.bookmarks",
  notifications: "communityPage.notifications", activity: "communityPage.activity", tags: "communityPage.tags",
  playlists: "communityPage.playlistPage.title",
};
const titleKey = modeTitleKeys[mode] || "community";
const title = t(locale, titleKey, mode === "feeds" ? "Community" : mode);

---
<Base locale={locale} route={route} title={title} titleKey={titleKey}><AppShell locale={locale} route={route} title={title} titleKey={titleKey}><community-workspace locale={locale} mode={mode}></community-workspace></AppShell></Base>
<script>import "../lit/community-workspace";</script>
