---
import Base from "../layouts/Base.astro";
import AppShell from "./AppShell.astro";
import { t } from "../i18n/messages";
import type { Locale } from "../i18n/locales";
import { resourcePath } from "../lib/resource-route";
import type { ReleaseServer } from "../lib/release-server";
import "../lit/live2d-workspace";
import "../styles/catalog.css";
import "../styles/viewer.css";
const { locale, server } = Astro.props as { locale: Locale; server?: ReleaseServer };
const title = t(locale, "navigation.live2d", "Live2D");
---
<Base locale={locale} route="/catalog/live2d" canonicalRoute={server ? resourcePath({ server, locale, kind: "live2d" }) : undefined} title={title} titleKey="navigation.live2d"><AppShell locale={locale} route="/catalog/live2d" title={title} titleKey="navigation.live2d" server={server}><live2d-workspace locale={locale}></live2d-workspace></AppShell></Base>
<script>import "../lit/live2d-workspace";</script>
