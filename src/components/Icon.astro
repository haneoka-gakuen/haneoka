---
interface Props { name: string; size?: number; label?: string; filled?: boolean }
const { name, size = 24, label, filled = false } = Astro.props;
---
<svg class="material-icon" width={size} height={size} aria-hidden={label ? undefined : "true"} role={label ? "img" : undefined} aria-label={label}>
  <use href={`/icons.svg#${name}${filled ? "-filled" : ""}`}></use>
</svg>
