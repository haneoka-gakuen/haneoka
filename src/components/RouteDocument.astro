---
import Base from "../layouts/Base.astro";
import AppShell from "./AppShell.astro";
import CatalogIndexPage from "./pages/CatalogIndexPage.astro";
import DownloadPage from "./pages/DownloadPage.astro";
import AboutPage from "./pages/AboutPage.astro";
import JoinPage from "./pages/JoinPage.astro";
import SponsorPage from "./pages/SponsorPage.astro";
import LegalPage from "./pages/LegalPage.astro";
import NoticePage from "./pages/NoticePage.astro";
import EventTrackerPage from "./pages/EventTrackerPage.astro";
import { nativeMetaPublicationFor } from "../server/native-meta-publication";
import { staticCatalogRelease } from "../lib/static-catalog-source";
import { catalogCollectionData, catalogCollectionDescription } from "../server/catalog-collection";
import { renderCatalogCollection } from "../server/render-catalog";
import { serializePageData } from "../lib/page-data";
import { catalogSystemData } from "../server/catalog-system-data";
import { renderCatalogSystem } from "../server/render-catalog-systems";
import { eventTrackerPageData } from "../server/event-tracker-page-data";
import { renderEventTracker } from "../server/render-event-tracker";
import { catalogConfig } from "../config/catalog-labels";
import { legalPageMessageRoot, type RouteDefinition } from "../config/routes";
import { LOCALES, type Locale } from "../i18n/locales";
import { t } from "../i18n/messages";
import { resourceCollectionHref } from "../lib/resource-route";
import type { ReleaseServer } from "../lib/release-server";
import "../lit/catalog-screen";
import "../styles/catalog.css";
import "../styles/about.css";

interface Props {
  locale: Locale;
  entry: RouteDefinition;
  title: string;
  server?: ReleaseServer;
  /** Explicit canonical for auxiliary server-first pages without a ResourceKind. */
  canonicalRoute?: string;
}
const { locale, entry, title, server, canonicalRoute: explicitCanonicalRoute } = Astro.props;
const documentDescriptionValues =
  entry.kind === "legal" && entry.page
    ? Object.fromEntries(LOCALES.map((target) => [
        target,
        t(target, `${legalPageMessageRoot(entry.page!)}.description`, t(target, `${legalPageMessageRoot(entry.page!)}.summary`, title)),
      ]))
    : undefined;
const nativeMetaReference = process.env.NATIVE_META_REFERENCE_RECEIPTS_JSON && entry.kind === "catalog" && ["songs", "song-meta"].includes(entry.resource || "")
  ? nativeMetaPublicationFor(await staticCatalogRelease(server || "intl"))
  : undefined;
const screenConfig =
  entry.kind === "catalog" && entry.resource
    ? catalogConfig({
        resource: entry.resource,
        ...(nativeMetaReference ? { nativeMetaReference } : {}),
        locale,
        ...(server ? { server } : {}),
        aspectRatio: entry.resource === "cards" ? "224 / 294" : "1",
      })
    : "";
const canonicalRoute = explicitCanonicalRoute ?? (server ? resourceCollectionHref(entry.route, server, locale) : undefined);
const collectionPayload = entry.kind === "catalog" && entry.resource
  ? await catalogCollectionData(entry.resource, server || "intl", locale)
  : undefined;
const collectionPage = collectionPayload ? renderCatalogCollection(screenConfig, collectionPayload, locale) : undefined;
const collectionDataId = `catalog-collection-${entry.resource}`;
const collectionDescription = collectionPayload ? catalogCollectionDescription(collectionPayload, locale, title) : undefined;
const systemPayload = entry.kind === "missions" || entry.kind === "studio" || entry.kind === "tgw-card" || entry.kind === "arena"
  ? await catalogSystemData(entry.kind, server || "intl", locale)
  : undefined;
const systemPage = systemPayload ? await renderCatalogSystem(systemPayload, locale) : undefined;
const systemDataId = `catalog-system-${entry.kind}`;
const trackerPayload = entry.kind === "event-tracker" ? await eventTrackerPageData() : undefined;
const trackerPage = trackerPayload ? await renderEventTracker(trackerPayload, locale, server || "intl") : undefined;

---

<Base
  locale={locale}
  route={entry.route}
  canonicalRoute={canonicalRoute}
  title={title}
  titleKey={entry.titleKey}
  description={collectionDescription ?? documentDescriptionValues?.[locale] ?? title}
  seoDescriptionValues={documentDescriptionValues}
>
  <AppShell locale={locale} route={entry.route} title={title} titleKey={entry.titleKey} server={server} appBar={collectionPage?.appBar || systemPage?.appBar || trackerPage?.appBar}>
    {entry.kind === "download" && <DownloadPage locale={locale} />}
    {entry.kind === "index" && <CatalogIndexPage locale={locale} server={server} />}
    {entry.kind === "legal" && entry.page === "aboutPage" && <AboutPage locale={locale} />}
    {entry.kind === "legal" && entry.page === "joinPage" && <JoinPage locale={locale} />}
    {entry.kind === "legal" && entry.page === "sponsorPage" && <SponsorPage locale={locale} />}
    {entry.kind === "legal" && entry.page && entry.page !== "aboutPage" && entry.page !== "joinPage" && entry.page !== "sponsorPage" && (
      <LegalPage locale={locale} page={entry.page} />
    )}
    {entry.kind === "notice" && (
      <NoticePage locale={locale} title={title} titleKey={entry.titleKey} route={entry.route} />
    )}
    {entry.kind === "catalog" && (
      <>
        <script is:inline type="application/json" id={collectionDataId} set:html={serializePageData(collectionPayload)}></script>
        <catalog-screen config={screenConfig} data-prerendered data-page-data={collectionDataId} set:html={collectionPage?.body || ""}></catalog-screen>
      </>
    )}
    {systemPayload && <script is:inline type="application/json" id={systemDataId} set:html={serializePageData(systemPayload)}></script>}
    {entry.kind === "tgw-card" && <tgw-card-workspace locale={locale} data-page-data={systemDataId} data-prerendered set:html={systemPage?.body || ""}></tgw-card-workspace>}
    {entry.kind === "arena" && <arena-workspace locale={locale} data-page-data={systemDataId} data-prerendered set:html={systemPage?.body || ""}></arena-workspace>}
    {entry.kind === "studio" && <studio-workspace locale={locale} data-page-data={systemDataId} data-prerendered set:html={systemPage?.body || ""}></studio-workspace>}
    {entry.kind === "missions" && <mission-workspace locale={locale} data-page-data={systemDataId} data-prerendered set:html={systemPage?.body || ""}></mission-workspace>}
    {entry.kind === "event-tracker" && <EventTrackerPage locale={locale} server={server} payload={trackerPayload} page={trackerPage} />}
  </AppShell>
</Base>
<script>
  import "../lit/catalog-screen";
  import "../lit/tgw-card-workspace";
  import "../lit/studio-workspace";
  import "../lit/arena-workspace";
  import "../lit/mission-workspace";
</script>
