---
import Base from "../layouts/Base.astro";
import AppShell from "./AppShell.astro";
import HomePage from "./pages/HomePage.astro";
import { t } from "../i18n/messages";
import type { Locale } from "../i18n/locales";
import type { ReleaseServer } from "../lib/release-server";
const { locale, server } = Astro.props as { locale: Locale; server?: ReleaseServer };
const canonicalRoute = server ? `/${server}/${locale}/` : undefined;
const title = t(locale, "home.dashboard.overview", "haneoka");
const seoTitle = t(locale, "common.seo.homeTitle", "BanG Dream! Our Notes Archive");

---

<Base locale={locale} route="/" canonicalRoute={canonicalRoute} title={title} titleKey="home.dashboard.overview" seoTitleValues={{ [locale]: seoTitle }}>
  <AppShell locale={locale} server={server} route="/" title={title} titleKey="home.dashboard.overview">
    <HomePage locale={locale} server={server} />
  </AppShell>
</Base>
