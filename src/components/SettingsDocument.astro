---
import Base from "../layouts/Base.astro";
import AppShell from "./AppShell.astro";
import Icon from "./Icon.astro";
import I18nText from "./I18nText.astro";
import SettingsOption from "./SettingsOption.astro";
import type { Locale } from "../i18n/locales";
import { t } from "../i18n/messages";
import { DATE_CHOICES, formatDate, formatTime, type DateChoiceKey, type DatePreferences } from "../lib/date-format";
import { BIRTHDAY, SEASONS, birthdaySeed, characterSeed, seasonSeed } from "../lib/themes";
import { themeCharacters } from "../server/theme-characters";
import "../styles/components/accordion.css";
import "../styles/settings.css";
import cnFlag from "circle-flags/flags/cn.svg?url";
import enUsFlag from "circle-flags/flags/language/en-us.svg?url";
import hkFlag from "circle-flags/flags/hk.svg?url";
import jpFlag from "circle-flags/flags/jp.svg?url";
import krFlag from "circle-flags/flags/kr.svg?url";
import bushimo from "../assets/icons/bushimo-circle.svg?url";
import { svg as bilibiliSvg } from "@thesvg/icons/bilibili";

const { locale } = Astro.props as { locale: Locale };
const characters = await themeCharacters(locale);
const bandIcon = (id: number) => `/assets/jp/Assets/AddressableResources/Band/${id}/band_small_Icon.png`;
const title = t(locale, "navigation.settings", "Settings");
const bilibiliBody = bilibiliSvg
  .replace(/^<svg[^>]*>/, "")
  .replace(/<title>.*?<\/title>/, "")
  .replace(/<\/svg>$/, "");
const bilibili = `data:image/svg+xml,${encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><circle cx="256" cy="256" r="256" fill="#00a1d6"/><g fill="#fff" transform="translate(76 76) scale(15)">${bilibiliBody}</g></svg>`)}`;
interface Option {
  value: string;
  label: string;
  keyName?: string;
  icon?: string;
  image?: string;
  swatch?: string;
  sample?: string;
  beta?: boolean;
  ring?: string;
  badge?: string;
  hidden?: boolean;
  data?: Record<string, string>;
  /** Starts a new row of options (each band's row of members). */
  row?: boolean;
}
interface Group {
  name: string;
  key: string;
  label: string;
  icon: string;
  initial: string;
  options: Option[];
}
// Thursday 5 March, 21:07:09 UTC: single-digit month and day show padding, the hour shows the cycle.
const sample = Date.UTC(2026, 2, 5, 21, 7, 9);
const morning = Date.UTC(2026, 2, 5, 9, 7, 9);
const dateSample = (preferences: Partial<DatePreferences>, year: "always" | "never" = "never") =>
  formatDate(locale, sample, { timeZone: "UTC", year, preferences: { weekday: "none", ...preferences } });
const timeSample = (preferences: Partial<DatePreferences>, at = sample) =>
  formatTime(locale, at, { timeZone: "UTC", preferences: { seconds: "off", ...preferences } });
const named = (key: string, label: string) => ({ keyName: `settings.labels.${key}`, label, sample: t(locale, `settings.labels.${key}`, label) });
const dateSamples: { [K in DateChoiceKey]: (value: DatePreferences[K]) => Partial<Option> } = {
  order: (order) => (order === "auto" ? named("dateAuto", "Auto") : { sample: dateSample({ order }, "always") }),
  month: (month) => ({ sample: dateSample({ month }) }),
  day: (day) => ({ sample: dateSample({ day }) }),
  separator: (separator) => ({ sample: dateSample({ month: "numeric", separator }, "always") }),
  year: (year) =>
    ({ auto: named("yearAuto", "Other years"), always: named("yearAlways", "Always"), never: named("yearNever", "Never") })[year],
  yearDigits: (yearDigits) => ({ sample: dateSample({ yearDigits }, "always") }),
  weekday: (weekday) => ({ sample: dateSample({ weekday }) }),
  cycle: (cycle) => ({ sample: timeSample({ cycle }) }),
  hour: (hour) => ({ sample: timeSample({ hour, cycle: "h23" }, morning) }),
  seconds: (seconds) => ({ sample: timeSample({ seconds }) }),
  zoneName: (zoneName) =>
    zoneName === "none"
      ? { sample: formatTime(locale, sample, { timeZone: "Asia/Tokyo", preferences: { seconds: "off" } }) }
      : { sample: formatTime(locale, sample, { preferences: { seconds: "off", zone: "Asia/Tokyo", zoneName } }) },
};
const dateTitles: Record<DateChoiceKey, [string, string, string]> = {
  order: ["dateOrder", "Date order", "swap_horiz"],
  month: ["dateMonth", "Month", "calendar_month"],
  day: ["dateDay", "Day", "event"],
  separator: ["dateSeparator", "Separator", "more_horiz"],
  year: ["dateYear", "Year", "calendar_month"],
  yearDigits: ["dateYearDigits", "Year digits", "pin"],
  weekday: ["dateWeekday", "Weekday", "event"],
  cycle: ["timeFormat", "Time format", "schedule"],
  hour: ["timeHour", "Hour", "schedule"],
  seconds: ["timeSeconds", "Seconds", "schedule"],
  zoneName: ["timeZoneName", "Time zone label", "public"],
};
const dateGroups: Group[] = (Object.keys(DATE_CHOICES) as DateChoiceKey[]).map((key) => {
  const [title, label, icon] = dateTitles[key];
  const values = (DATE_CHOICES[key] as readonly string[]).filter((value) => key !== "day" || value !== "ordinal" || locale === "en");
  return {
    name: `date-${key}`,
    key: `settings.labels.${title}`,
    label,
    icon,
    initial: values[0],
    options: values.map((value) => {
      const option = (dateSamples[key] as (value: string) => Partial<Option>)(value);
      return { value, label: option.sample ?? value, ...option } as Option;
    }),
  };
});
const timeZones = (Intl as typeof Intl & { supportedValuesOf(kind: "timeZone"): string[] }).supportedValuesOf("timeZone");
const preview = formatDate(locale, sample, { time: true, timeZone: "UTC" });

const groups: Group[] = [
  {
    name: "theme",
    key: "settings.labels.appearance",
    label: "Appearance",
    icon: "palette",
    initial: "system",
    options: [
      { value: "light", icon: "light_mode", keyName: "settings.labels.themeLight", label: "Light" },
      { value: "system", icon: "brightness_auto", keyName: "settings.labels.themeSystem", label: "Follow system" },
      { value: "dark", icon: "dark_mode", keyName: "settings.labels.themeDark", label: "Dark" },
    ],
  },
  {
    name: "seed",
    key: "settings.labels.themeColor",
    label: "Theme color",
    icon: "format_paint",
    initial: "haneoka",
    options: [
      { value: "haneoka", swatch: "haneoka", keyName: "settings.labels.tuneDefault", label: "Original key" },
      ...SEASONS.map((season) => ({
        value: seasonSeed(season.id),
        icon: season.ornament,
        keyName: `settings.seasons.${season.key}`,
        label: season.label,
        hidden: true,
        data: { season: season.id },
      })),
      ...characters
        .filter((character) => character.birthday)
        .map((character) => ({
          value: birthdaySeed(character.id),
          image: character.face,
          ring: character.color,
          badge: BIRTHDAY.ornament,
          label: character.name,
          hidden: true,
          data: { birthday: character.birthday!.join("-"), color: character.color },
        })),
      ...[1, 2, 3, 4, 5].flatMap((id) => [
        { value: `band-${id}`, image: bandIcon(id), keyName: `catalog.bands.names.${id}`, label: `Band ${id}`, row: true },
        ...characters
          .filter((character) => character.bandId === id)
          .map((character) => ({
            value: characterSeed(character.id),
            image: character.face,
            ring: character.color,
            label: character.name,
            data: { color: character.color },
          })),
      ]),
    ],
  },
  {
    name: "density",
    key: "common.layout.density",
    label: "Spacing",
    icon: "density_medium",
    initial: "comfortable",
    options: [
      { value: "comfortable", icon: "density_medium", keyName: "common.layout.comfortable", label: "Comfortable" },
      { value: "compact", icon: "density_small", keyName: "common.layout.compact", label: "Compact" },
    ],
  },
  ...dateGroups,
  {
    name: "locale",
    key: "settings.labels.language",
    label: "Language",
    icon: "language",
    initial: locale,
    options: [
      { value: "ja", image: jpFlag, label: "日本語" },
      { value: "en", image: enUsFlag, label: "English" },
      { value: "zh-TW", image: hkFlag, label: "繁體中文" },
      { value: "zh-CN", image: cnFlag, label: "简体中文" },
      { value: "ko", image: krFlag, label: "한국어" },
    ],
  },
  {
    name: "release",
    key: "settings.labels.releaseServer",
    label: "Release server",
    icon: "dns",
    initial: "intl",
    options: [
      { value: "jp", image: bushimo, keyName: "settings.labels.settingsJapan", label: "JP" },
      { value: "intl", image: bilibili, keyName: "settings.labels.settingsGlobal", label: "Global" },
    ],
  },
];
const japaneseLabel = "settings.labels.forceJapaneseTitles";
const estimatedDifficultyLabel = "settings.labels.showDifficultyEstimates";
---

<Base locale={locale} route="/settings" title={title} titleKey="navigation.settings">
  <AppShell locale={locale} route="/settings" title={title} titleKey="navigation.settings">
    <section class="page">
      <div class="settings-content">
        {[groups.slice(0, 3), groups.slice(3 + dateGroups.length, 4 + dateGroups.length), groups.slice(4 + dateGroups.length), dateGroups].map((card) => (
          <div class:list={["settings-card", { "md-accordion settings-dates": card === dateGroups }]}>
            {card === dateGroups && (
              <div class="md-accordion__heading" role="heading" aria-level="2">
                <button
                  class="button md-accordion__trigger"
                  type="button"
                  id="settings-dates-trigger"
                  aria-expanded="false"
                  aria-controls="settings-dates-panel"
                  data-settings-dates
                >
                  <span class="md-accordion__leading" aria-hidden="true"><Icon name="schedule" /></span>
                  <span class="md-accordion__identity">
                    <span class="md-accordion__label">
                      <I18nText keyName="settings.labels.dateTime" fallback="Date and time" locale={locale} />
                    </span>
                    <span class="md-accordion__supporting" data-date-preview>{preview}</span>
                  </span>
                  <span class="md-accordion__chevron" aria-hidden="true"><Icon name="expand_more" /></span>
                </button>
              </div>
            )}
            <div
              class={card === dateGroups ? "md-accordion__panel" : "settings-card__body"}
              id={card === dateGroups ? "settings-dates-panel" : undefined}
              role={card === dateGroups ? "region" : undefined}
              aria-labelledby={card === dateGroups ? "settings-dates-trigger" : undefined}
              hidden={card === dateGroups}
            >
            {card === dateGroups && (
              <section class="settings-group" aria-labelledby="date-zone-title">
                <div class="settings-row">
                  <header class="settings-row__header">
                    <span class="settings-row__icon">
                      <Icon name="public" />
                    </span>
                    <div>
                      <h2 id="date-zone-title">
                        <I18nText keyName="settings.labels.timeZone" fallback="Time zone" locale={locale} />
                      </h2>
                      <p class="settings-current" data-date-zone-current aria-live="polite"></p>
                    </div>
                  </header>
                  <md-outlined-select
                    class="settings-zone"
                    data-date-zone
                    menu-positioning="popover"
                    aria-label={t(locale, "settings.labels.timeZone", "Time zone")}
                    data-i18n-aria-label="settings.labels.timeZone"
                    data-i18n-aria-label-fallback="Time zone"
                  >
                    <md-select-option value="local" selected>
                      <div slot="headline" data-i18n="settings.labels.zoneLocal" data-i18n-fallback="Local time">
                        {t(locale, "settings.labels.zoneLocal", "Local time")}
                      </div>
                    </md-select-option>
                    <md-select-option value="UTC"><div slot="headline">UTC</div></md-select-option>
                    {timeZones.map((zone) => (
                      <md-select-option value={zone}>
                        <div slot="headline">{zone.replaceAll("_", " ")}</div>
                      </md-select-option>
                    ))}
                  </md-outlined-select>
                </div>
              </section>
            )}
            {card.map((group) => (
              <section class="settings-group" aria-labelledby={`${group.name}-title`}>
                <div class="settings-row">
                  <header class="settings-row__header">
                    <span class="settings-row__icon">
                      <Icon name={group.icon} />
                    </span>
                    <div>
                      <h2 id={`${group.name}-title`}>
                        <I18nText keyName={group.key} fallback={group.label} locale={locale} />
                      </h2>
                      <p class="settings-current" data-current={group.name} aria-live="polite"></p>
                    </div>
                  </header>
                  <div
                    class:list={["settings-options", `settings-options--${group.name}`]}
                    role="radiogroup"
                    aria-labelledby={`${group.name}-title`}
                    data-settings-group={group.name}
                  >
                    {group.options.map((option) => (
                      <>
                        {option.row && <span class="settings-options__row" aria-hidden="true"></span>}
                        <SettingsOption
                          {...option}
                          name={group.name}
                          locale={locale}
                          selected={option.value === group.initial}
                        />
                      </>
                    ))}
                  </div>
                </div>
                {group.name === "seed" && (
                  <div class="settings-toggle" data-season-effects-row hidden>
                    <label for="season-effects">
                      <Icon name="auto_awesome" size={20} />
                      <I18nText keyName="settings.labels.seasonEffects" fallback="Seasonal effects" locale={locale} />
                    </label>
                    <md-switch
                      id="season-effects"
                      data-season-effects
                      icons
                      aria-label={t(locale, "settings.labels.seasonEffects", "Seasonal effects")}
                      data-i18n-aria-label="settings.labels.seasonEffects"
                      data-i18n-aria-label-fallback="Seasonal effects"
                    ></md-switch>
                  </div>
                )}
                {group.name === "locale" && (
                  <div class="settings-toggle">
                    <label for="japanese-titles">
                      <Icon name="music_note" size={20} />
                      <I18nText keyName={japaneseLabel} fallback="Show Japanese song titles" locale={locale} />
                    </label>
                    <md-switch
                      id="japanese-titles"
                      data-japanese-titles
                      icons
                      aria-label={t(locale, japaneseLabel, "Show Japanese song titles")}
                      data-i18n-aria-label={japaneseLabel}
                      data-i18n-aria-label-fallback="Show Japanese song titles"
                    ></md-switch>
                  </div>
                )}
                {group.name === "locale" && (
                  <div class="settings-toggle">
                    <label for="difficulty-estimates">
                      <Icon name="bar_chart" size={20} />
                      <span>
                        <I18nText keyName={estimatedDifficultyLabel} fallback="Show estimated difficulty" locale={locale} />
                        <small id="difficulty-estimates-beta" class="md-label-small"> Beta</small>
                      </span>
                    </label>
                    <md-switch
                      id="difficulty-estimates"
                      data-difficulty-estimates
                      aria-describedby="difficulty-estimates-beta"
                      icons
                      aria-label={t(locale, estimatedDifficultyLabel, "Show estimated difficulty")}
                      data-i18n-aria-label={estimatedDifficultyLabel}
                      data-i18n-aria-label-fallback="Show estimated difficulty"
                    ></md-switch>
                  </div>
                )}
              </section>
            ))}
            </div>
          </div>
        ))}
      </div>
    </section>
  </AppShell>
</Base>

<script>
  import "@material/web/switch/switch.js";
  import "@material/web/select/outlined-select.js";
  import "@material/web/select/select-option.js";
  import { applySeed, currentSeed, isSeed } from "../lib/tuning";
  import { BIRTHDAY, DYNAMIC_SEED, SEASONS, dayOf, openSeasons, seedCloses, type ThemeCharacter } from "../lib/themes";
  import { applyDensity, currentDensity, isDensity } from "../lib/density";
  import {
    datePreferences,
    formatDate,
    isDateChoice,
    isDateChoiceKey,
    isTimeZone,
    setDatePreferences,
    DATE_CHOICES,
    type DateChoiceKey,
  } from "../lib/date-format";
  import { japaneseSongTitles, setJapaneseSongTitles } from "../lib/song-display";
  import { difficultyEstimatesEnabled, setDifficultyEstimatesEnabled, observeDifficultyDisplay } from "../lib/difficulty-display";
  import { isReleaseServer, readSelectedReleaseServer, releaseServerPath, writeReleaseServer } from "../lib/release-server";
  import { isLocale, localePath } from "../i18n/locales";

  type SettingsWindow = Window & { __haneokaApplyLocale?: (locale: string) => void; __haneokaApplyTheme?: () => void };
  let disposeSettings: (() => void) | undefined;
  /** The characters as the option labels carry them, for birthdays and closing times. */
  const optionCharacters = (settings: HTMLElement): ThemeCharacter[] =>
    [...settings.querySelectorAll<HTMLElement>(".settings-option[data-birthday]")].map((option) => {
      const [month, day] = option.dataset.birthday!.split("-").map(Number);
      const id = Number(option.querySelector("input")!.value.split("-")[1]);
      return { id, bandId: 0, color: option.dataset.color!, face: "", name: "", birthday: [month!, day!] };
    });
  /** Seasonal themes are listed only while they are open. */
  const revealSeasons = (settings: HTMLElement) => {
    const open = new Set(openSeasons().map((season) => season.id));
    const today = dayOf(new Date());
    let any = false;
    settings.querySelectorAll<HTMLElement>(".settings-option[data-season], .settings-option[data-birthday]").forEach((option) => {
      const visible = option.dataset.season
        ? open.has(option.dataset.season)
        : option.dataset.birthday === `${today.month}-${today.day}`;
      option.hidden = !visible;
      any ||= visible;
    });
    const row = settings.querySelector<HTMLElement>("[data-season-effects-row]");
    if (row) row.hidden = !any;
  };
  const applyDynamicSeed = async (input: HTMLInputElement, seed: string, origin: { x: number; y: number }) => {
    const settings = input.closest<HTMLElement>(".settings-content")!;
    const option = input.closest<HTMLElement>(".settings-option")!;
    const [{ seedCss }, { celebrate }] = await Promise.all([import("../lib/theme-schemes"), import("../lib/seasonal")]);
    const season = SEASONS.find((entry) => `season-${entry.id}` === seed);
    const mark = season
      ? { id: season.id, motif: season.motif, ornament: season.ornament, shape: season.shape }
      : seed.startsWith("birthday-")
        ? { id: "birthday", motif: BIRTHDAY.motif, ornament: BIRTHDAY.ornament, shape: BIRTHDAY.shape }
        : null;
    const css = seedCss(seed, season ?? option.dataset.color!);
    applySeed(seed, origin, { css, closes: seedCloses(seed, optionCharacters(settings)), season: mark });
    if (mark) celebrate(mark.motif, origin);
  };
  const initializeSettings = () => {
    disposeSettings?.();
    const settings = document.querySelector<HTMLElement>(".settings-content");
    if (!settings) return;
    const controller = new AbortController();
    const { signal } = controller;
    let stopDifficultyDisplay: (() => void) | undefined;
    disposeSettings = () => {
      controller.abort();
      stopDifficultyDisplay?.();
    };
    const updateSummary = (group: string) => {
      const selected = settings.querySelector<HTMLInputElement>(`input[name="${group}"]:checked`);
      const output = settings.querySelector<HTMLElement>(`[data-current="${group}"]`);
      if (output) output.textContent = selected?.getAttribute("aria-label") || "";
    };
    const select = (name: string, value: string) => {
      settings
        .querySelectorAll<HTMLInputElement>(`input[name="${name}"]`)
        .forEach((input) => (input.checked = input.value === value));
      updateSummary(name);
    };
    const syncLocale = () => {
      select("locale", document.documentElement.dataset.locale || "ja");
      settings
        .querySelectorAll<HTMLElement>("[data-settings-group]")
        .forEach((group) => updateSummary(group.dataset.settingsGroup!));
    };
    select("theme", document.documentElement.dataset.themePreference || "system");
    revealSeasons(settings);
    select("seed", currentSeed());
    const effects = settings.querySelector<HTMLElement & { selected: boolean }>("[data-season-effects]");
    if (effects) {
      void import("../lib/seasonal").then(({ effectsEnabled, setEffectsEnabled }) => {
        effects.selected = effectsEnabled();
        effects.addEventListener("change", () => setEffectsEnabled(effects.selected), { signal });
      });
    }
    select("density", currentDensity());
    const dates = datePreferences();
    const datePreview = settings.querySelector<HTMLElement>("[data-date-preview]");
    const showDatePreview = () => {
      if (datePreview) datePreview.textContent = formatDate(document.documentElement.lang || "ja", Date.now(), { time: true });
    };
    (Object.keys(DATE_CHOICES) as DateChoiceKey[]).forEach((key) => select(`date-${key}`, dates[key]));
    showDatePreview();
    const datesTrigger = settings.querySelector<HTMLButtonElement>("[data-settings-dates]");
    datesTrigger?.addEventListener(
      "click",
      () => {
        const open = datesTrigger.getAttribute("aria-expanded") !== "true";
        datesTrigger.closest(".md-accordion")?.setAttribute("data-toggled", "");
        datesTrigger.setAttribute("aria-expanded", String(open));
        document.getElementById("settings-dates-panel")!.hidden = !open;
      },
      { signal },
    );
    const zone = settings.querySelector<HTMLElement & { value: string; displayText: string }>("[data-date-zone]");
    const zoneCurrent = settings.querySelector<HTMLElement>("[data-date-zone-current]");
    const showZone = () => {
      if (zone && zoneCurrent) zoneCurrent.textContent = zone.displayText || "";
    };
    if (zone) {
      zone.value = dates.zone;
      void customElements.whenDefined("md-outlined-select").then(() => requestAnimationFrame(showZone));
      zone.addEventListener(
        "change",
        () => {
          if (isTimeZone(zone.value)) setDatePreferences({ zone: zone.value });
          showDatePreview();
          showZone();
        },
        { signal },
      );
    }
    select("release", readSelectedReleaseServer());
    syncLocale();
    requestAnimationFrame(() => {
      if (!signal.aborted) settings.dataset.ready = "true";
    });
    addEventListener("haneoka:locale-ready", syncLocale, { signal });
    settings.addEventListener(
      "change",
      (event) => {
        const input = event.target;
        if (!(input instanceof HTMLInputElement) || input.type !== "radio") return;
        const { name, value } = input;
        if (name === "theme") {
          try {
            localStorage.setItem("haneoka.ui-theme.v1", value);
          } catch {}
          (window as SettingsWindow).__haneokaApplyTheme?.();
        } else if (name === "seed" && isSeed(value)) {
          const rect = input.getBoundingClientRect();
          const origin = { x: rect.left + rect.width / 2, y: rect.top + rect.height / 2 };
          if (DYNAMIC_SEED.test(value)) void applyDynamicSeed(input, value, origin);
          else applySeed(value, origin);
        } else if (name === "density" && isDensity(value)) {
          applyDensity(value);
        } else if (name.startsWith("date-")) {
          const key = name.slice(5);
          if (isDateChoiceKey(key) && isDateChoice(key, value)) setDatePreferences({ [key]: value });
          showDatePreview();
        } else if (name === "locale" && isLocale(value)) {
          location.assign(`${localePath(location.pathname, value)}${location.search}${location.hash}`);
          return;
        } else if (name === "release" && isReleaseServer(value)) {
          // The URL prefix is the release server's address: a change of server
          // is a change of page, not an in-place data swap.
          const current = readSelectedReleaseServer();
          writeReleaseServer(value);
          if (value !== current) {
            location.assign(releaseServerPath(`${location.pathname}${location.search}${location.hash}`, value));
            return;
          }
        }
        updateSummary(name);
      },
      { signal },
    );
    const estimatedDifficulty = settings.querySelector<HTMLElement & { selected: boolean }>("[data-difficulty-estimates]");
    const syncEstimatedDifficulty = () => {
      if (estimatedDifficulty) estimatedDifficulty.selected = difficultyEstimatesEnabled();
    };
    syncEstimatedDifficulty();
    stopDifficultyDisplay = observeDifficultyDisplay(syncEstimatedDifficulty);
    estimatedDifficulty?.addEventListener("change", () => {
      setDifficultyEstimatesEnabled(estimatedDifficulty.selected);
    }, { signal });
    const japanese = settings.querySelector<HTMLElement & { selected: boolean }>("[data-japanese-titles]");
    if (japanese) japanese.selected = japaneseSongTitles();
    japanese?.addEventListener(
      "change",
      () => {
        setJapaneseSongTitles(japanese.selected);
      },
      { signal },
    );
  };
  initializeSettings();
  document.addEventListener("astro:page-load", initializeSettings);
  document.addEventListener("astro:before-swap", () => disposeSettings?.());
</script>
