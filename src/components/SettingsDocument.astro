---
import Base from "../layouts/Base.astro";
import AppShell from "./AppShell.astro";
import Icon from "./Icon.astro";
import I18nText from "./I18nText.astro";
import { LOCALES, type Locale } from "../i18n/locales";
import { t } from "../i18n/messages";
import "../styles/account-settings.css";
import cnFlag from "circle-flags/flags/cn.svg?url";
import gbFlag from "circle-flags/flags/gb.svg?url";
import hkFlag from "circle-flags/flags/hk.svg?url";
import jpFlag from "circle-flags/flags/jp.svg?url";
import krFlag from "circle-flags/flags/kr.svg?url";
import bushimo from "../assets/icons/bushimo-circle.svg?url";
import { svg as bilibiliSvg } from "@thesvg/icons/bilibili";

const { locale } = Astro.props as { locale: Locale };
const title = t(locale, "settings", "Settings");
const flags = { ja: jpFlag, en: gbFlag, "zh-TW": hkFlag, "zh-CN": cnFlag, ko: krFlag } as const;
const bilibiliBody = bilibiliSvg.replace(/^<svg[^>]*>/, "").replace(/<title>.*?<\/title>/, "").replace(/<\/svg>$/, "");
const bilibili = `data:image/svg+xml,${encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><circle cx="256" cy="256" r="256" fill="#00a1d6"/><g fill="#fff" transform="translate(76 76) scale(15)">${bilibiliBody}</g></svg>`)}`;
const themeOptions = [["light", "light_mode", "themeLight"], ["system", "brightness_auto", "themeSystem"], ["dark", "dark_mode", "themeDark"]] as const;
const releases = [["jp-cbt", bushimo], ["gl-cbt", bilibili]] as const;
const labelValues = (key: string, fallback: string) => JSON.stringify(Object.fromEntries(LOCALES.map((target) => [target, t(target, key, fallback)])));
const languageNames = { ja: "日本語", en: "English", "zh-TW": "繁體中文", "zh-CN": "简体中文", ko: "한국어" } as const;
const releaseNames = { "jp-cbt": "Japan CBT", "gl-cbt": "Global CBT" } as const;
---

<Base locale={locale} route="/settings" title={title} titleKey="settings">
  <AppShell locale={locale} route="/settings" title={title} titleKey="settings">
    <section class="page"><div class="settings-content">
      <section class="page-section">
        <header class="page-section__header"><span class="page-section__icon"><Icon name="palette" /></span><h2><I18nText keyName="appearance" fallback="Appearance" locale={locale} /></h2></header>
        <div class="icon-row" data-theme-choices role="radiogroup">{themeOptions.map(([value, icon, key]) => <button class="icon-row__item" type="button" role="radio" data-value={value} data-icon={icon} aria-label={t(locale,key,value)} data-i18n-aria-label-values={labelValues(key,value)}><Icon name={icon} /></button>)}</div>
      </section>
      <section class="page-section is-divided">
        <header class="page-section__header"><span class="page-section__icon"><Icon name="language" /></span><h2><I18nText keyName="language" fallback="Language" locale={locale} /></h2></header>
        <div class="settings-controls">
          <div class="icon-row" data-locale-choices role="radiogroup">{Object.entries(flags).map(([value,image]) => <button class="icon-row__item" type="button" role="radio" data-value={value} aria-label={languageNames[value as keyof typeof languageNames]}><img class="icon-row__image" src={image} alt="" /></button>)}</div>
          <label class="settings-switch"><I18nText keyName="forceJapaneseTitles" fallback="Show Japanese song titles" locale={locale} /><md-switch data-japanese-titles></md-switch></label>
        </div>
      </section>
      <section class="page-section is-divided">
        <header class="page-section__header"><span class="page-section__icon"><Icon name="dns" /></span><h2><I18nText keyName="releaseServer" fallback="Release server" locale={locale} /></h2></header>
        <div class="icon-row" data-release-choices role="radiogroup">{releases.map(([value,image]) => <button class="icon-row__item" type="button" role="radio" data-value={value} aria-label={releaseNames[value]}><span class="server-icon"><img src={image} alt="" /><i>β</i></span></button>)}</div>
      </section>
    </div></section>
  </AppShell>
</Base>

<script>
  import "@material/web/switch/switch.js";
  type LocaleWindow = Window & { __haneokaApplyLocale?: (locale: string) => void; __haneokaApplyTheme?: () => void };
  const select = (root: Element | null, value: string) => root?.querySelectorAll<HTMLElement>("[data-value]").forEach((node) => {
    const selected = node.dataset.value === value;
    node.classList.toggle("is-selected", selected);
    node.setAttribute("aria-checked", String(selected));
    const icon = node.dataset.icon, use = node.querySelector("use");
    if (icon && use) use.setAttribute("href", `/icons.svg#${icon}${selected ? "-filled" : ""}`);
  });
  const initializeSettings = () => {
  const settings = document.querySelector<HTMLElement>(".settings-content");
  if (!settings || settings.dataset.initialized === "true") return;
  settings.dataset.initialized = "true";
  const theme = settings.querySelector("[data-theme-choices]"); let themeValue = "system";
  try { themeValue = localStorage.getItem("haneoka.ui-theme.v1") || "system"; } catch {}
  select(theme, themeValue);
  theme?.querySelectorAll<HTMLElement>("[data-value]").forEach((node) => node.addEventListener("click", () => {
    const value = node.dataset.value || "system"; try { localStorage.setItem("haneoka.ui-theme.v1", value); } catch {}
    (window as LocaleWindow).__haneokaApplyTheme?.(); select(theme, value);
  }));
  const locales = settings.querySelector("[data-locale-choices]"); select(locales, document.documentElement.dataset.locale || "ja");
  locales?.querySelectorAll<HTMLElement>("[data-value]").forEach((node) => node.addEventListener("click", () => { const value = node.dataset.value || "ja"; (window as LocaleWindow).__haneokaApplyLocale?.(value); select(locales, value); }));
  const release = settings.querySelector("[data-release-choices]"); let releaseValue = "gl-cbt";
  try { releaseValue = localStorage.getItem("haneoka.release-server") || "gl-cbt"; } catch {}
  select(release, releaseValue);
  release?.querySelectorAll<HTMLElement>("[data-value]").forEach((node) => node.addEventListener("click", () => { const value = node.dataset.value || "gl-cbt"; try { localStorage.setItem("haneoka.release-server", value); } catch {} select(release, value); }));
  const japanese = settings.querySelector<HTMLElement & { selected: boolean }>("[data-japanese-titles]");
  try { const saved = JSON.parse(localStorage.getItem("haneoka:song-display:v1") || "{}"); if (japanese) japanese.selected = Boolean(saved.forceJapaneseTitles); } catch {}
  japanese?.addEventListener("change", () => { try { localStorage.setItem("haneoka:song-display:v1", JSON.stringify({ forceJapaneseTitles: japanese.selected })); } catch {} });
  };
  initializeSettings();
  document.addEventListener("astro:page-load", initializeSettings);
</script>
