---
import Base from "../layouts/Base.astro";
import AppShell from "./AppShell.astro";
import Icon from "./Icon.astro";
import I18nText from "./I18nText.astro";
import SettingsOption from "./SettingsOption.astro";
import type { Locale } from "../i18n/locales";
import { t } from "../i18n/messages";
import "../styles/settings.css";
import cnFlag from "circle-flags/flags/cn.svg?url";
import enUsFlag from "circle-flags/flags/language/en-us.svg?url";
import hkFlag from "circle-flags/flags/hk.svg?url";
import jpFlag from "circle-flags/flags/jp.svg?url";
import krFlag from "circle-flags/flags/kr.svg?url";
import bushimo from "../assets/icons/bushimo-circle.svg?url";
import { svg as bilibiliSvg } from "@thesvg/icons/bilibili";

const { locale } = Astro.props as { locale: Locale };
const title = t(locale, "settings", "Settings");
const bilibiliBody = bilibiliSvg
  .replace(/^<svg[^>]*>/, "")
  .replace(/<title>.*?<\/title>/, "")
  .replace(/<\/svg>$/, "");
const bilibili = `data:image/svg+xml,${encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><circle cx="256" cy="256" r="256" fill="#00a1d6"/><g fill="#fff" transform="translate(76 76) scale(15)">${bilibiliBody}</g></svg>`)}`;
interface Option {
  value: string;
  label: string;
  keyName?: string;
  icon?: string;
  image?: string;
  swatch?: string;
  beta?: boolean;
}
interface Group {
  name: string;
  key: string;
  label: string;
  icon: string;
  initial: string;
  options: Option[];
}
const groups: Group[] = [
  {
    name: "theme",
    key: "appearance",
    label: "Appearance",
    icon: "palette",
    initial: "system",
    options: [
      { value: "light", icon: "light_mode", keyName: "themeLight", label: "Light" },
      { value: "system", icon: "brightness_auto", keyName: "themeSystem", label: "Follow system" },
      { value: "dark", icon: "dark_mode", keyName: "themeDark", label: "Dark" },
    ],
  },
  {
    name: "seed",
    key: "themeColor",
    label: "Theme color",
    icon: "format_paint",
    initial: "haneoka",
    options: [
      { value: "haneoka", swatch: "haneoka", keyName: "tuneDefault", label: "Original key" },
      ...[1, 2, 3, 4, 5].map((id) => ({
        value: `band-${id}`,
        swatch: `band-${id}`,
        keyName: `band.${id}`,
        label: `Band ${id}`,
      })),
    ],
  },
  {
    name: "density",
    key: "density",
    label: "Spacing",
    icon: "density_medium",
    initial: "comfortable",
    options: [
      { value: "comfortable", icon: "density_medium", keyName: "comfortable", label: "Comfortable" },
      { value: "compact", icon: "density_small", keyName: "compact", label: "Compact" },
    ],
  },
  {
    name: "locale",
    key: "language",
    label: "Language",
    icon: "language",
    initial: locale,
    options: [
      { value: "ja", image: jpFlag, label: "日本語" },
      { value: "en", image: enUsFlag, label: "English" },
      { value: "zh-TW", image: hkFlag, label: "繁體中文" },
      { value: "zh-CN", image: cnFlag, label: "简体中文" },
      { value: "ko", image: krFlag, label: "한국어" },
    ],
  },
  {
    name: "release",
    key: "releaseServer",
    label: "Release server",
    icon: "dns",
    initial: "intl",
    options: [
      { value: "jp", image: bushimo, keyName: "settingsJapan", label: "Japan" },
      { value: "intl", image: bilibili, keyName: "settingsGlobal", label: "Global" },
    ],
  },
];
const japaneseLabel = "forceJapaneseTitles";
const estimatedDifficultyLabel = "showDifficultyEstimates";
---

<Base locale={locale} route="/settings" title={title} titleKey="settings">
  <AppShell locale={locale} route="/settings" title={title} titleKey="settings">
    <section class="page">
      <div class="settings-content">
        {[groups.slice(0, 3), groups.slice(3, 4), groups.slice(4)].map((card) => (
          <div class="settings-card">
            {card.map((group) => (
              <section class="settings-group" aria-labelledby={`${group.name}-title`}>
                <div class="settings-row">
                  <header class="settings-row__header">
                    <span class="settings-row__icon">
                      <Icon name={group.icon} />
                    </span>
                    <div>
                      <h2 id={`${group.name}-title`}>
                        <I18nText keyName={group.key} fallback={group.label} locale={locale} />
                      </h2>
                      <p class="settings-current" data-current={group.name} aria-live="polite"></p>
                    </div>
                  </header>
                  <div
                    class:list={["settings-options", `settings-options--${group.name}`]}
                    role="radiogroup"
                    aria-labelledby={`${group.name}-title`}
                    data-settings-group={group.name}
                  >
                    {group.options.map((option) => (
                      <SettingsOption
                        {...option}
                        name={group.name}
                        locale={locale}
                        selected={option.value === group.initial}
                      />
                    ))}
                  </div>
                </div>
                {group.name === "locale" && (
                  <div class="settings-toggle">
                    <label for="japanese-titles">
                      <Icon name="music_note" size={20} />
                      <I18nText keyName={japaneseLabel} fallback="Show Japanese song titles" locale={locale} />
                    </label>
                    <md-switch
                      id="japanese-titles"
                      data-japanese-titles
                      icons
                      aria-label={t(locale, japaneseLabel, "Show Japanese song titles")}
                      data-i18n-aria-label={japaneseLabel}
                      data-i18n-aria-label-fallback="Show Japanese song titles"
                    ></md-switch>
                  </div>
                )}
                {group.name === "locale" && (
                  <div class="settings-toggle">
                    <label for="difficulty-estimates">
                      <Icon name="bar_chart" size={20} />
                      <span>
                        <I18nText keyName={estimatedDifficultyLabel} fallback="Show estimated difficulty" locale={locale} />
                        <small id="difficulty-estimates-beta" class="md-label-small"> Beta</small>
                      </span>
                    </label>
                    <md-switch
                      id="difficulty-estimates"
                      data-difficulty-estimates
                      aria-describedby="difficulty-estimates-beta"
                      icons
                      aria-label={t(locale, estimatedDifficultyLabel, "Show estimated difficulty")}
                      data-i18n-aria-label={estimatedDifficultyLabel}
                      data-i18n-aria-label-fallback="Show estimated difficulty"
                    ></md-switch>
                  </div>
                )}
              </section>
            ))}
          </div>
        ))}
      </div>
    </section>
  </AppShell>
</Base>

<script>
  import "@material/web/switch/switch.js";
  import { applySeed, currentSeed, isSeed } from "../lib/tuning";
  import { applyDensity, currentDensity, isDensity } from "../lib/density";
  import { japaneseSongTitles, setJapaneseSongTitles } from "../lib/song-display";
  import { difficultyEstimatesEnabled, setDifficultyEstimatesEnabled, observeDifficultyDisplay } from "../lib/difficulty-display";
  import { isReleaseServer, readReleaseServer, releaseServerPath, writeReleaseServer } from "../lib/release-server";
  import { isLocale, localePath } from "../i18n/locales";

  type SettingsWindow = Window & { __haneokaApplyLocale?: (locale: string) => void; __haneokaApplyTheme?: () => void };
  let disposeSettings: (() => void) | undefined;
  const initializeSettings = () => {
    disposeSettings?.();
    const settings = document.querySelector<HTMLElement>(".settings-content");
    if (!settings) return;
    const controller = new AbortController();
    const { signal } = controller;
    let stopDifficultyDisplay: (() => void) | undefined;
    disposeSettings = () => {
      controller.abort();
      stopDifficultyDisplay?.();
    };
    const updateSummary = (group: string) => {
      const selected = settings.querySelector<HTMLInputElement>(`input[name="${group}"]:checked`);
      const output = settings.querySelector<HTMLElement>(`[data-current="${group}"]`);
      if (output) output.textContent = selected?.getAttribute("aria-label") || "";
    };
    const select = (name: string, value: string) => {
      settings
        .querySelectorAll<HTMLInputElement>(`input[name="${name}"]`)
        .forEach((input) => (input.checked = input.value === value));
      updateSummary(name);
    };
    const syncLocale = () => {
      select("locale", document.documentElement.dataset.locale || "ja");
      settings
        .querySelectorAll<HTMLElement>("[data-settings-group]")
        .forEach((group) => updateSummary(group.dataset.settingsGroup!));
    };
    select("theme", document.documentElement.dataset.themePreference || "system");
    select("seed", currentSeed());
    select("density", currentDensity());
    select("release", readReleaseServer());
    syncLocale();
    requestAnimationFrame(() => {
      if (!signal.aborted) settings.dataset.ready = "true";
    });
    addEventListener("haneoka:locale-ready", syncLocale, { signal });
    settings.addEventListener(
      "change",
      (event) => {
        const input = event.target;
        if (!(input instanceof HTMLInputElement) || input.type !== "radio") return;
        const { name, value } = input;
        if (name === "theme") {
          try {
            localStorage.setItem("haneoka.ui-theme.v1", value);
          } catch {}
          (window as SettingsWindow).__haneokaApplyTheme?.();
        } else if (name === "seed" && isSeed(value)) {
          const rect = input.getBoundingClientRect();
          applySeed(value, { x: rect.left + rect.width / 2, y: rect.top + rect.height / 2 });
        } else if (name === "density" && isDensity(value)) {
          applyDensity(value);
        } else if (name === "locale" && isLocale(value)) {
          location.assign(`${localePath(location.pathname, value)}${location.search}${location.hash}`);
          return;
        } else if (name === "release" && isReleaseServer(value)) {
          // The URL prefix is the release server's address: a change of server
          // is a change of page, not an in-place data swap.
          const current = readReleaseServer();
          writeReleaseServer(value);
          if (value !== current) {
            location.assign(releaseServerPath(`${location.pathname}${location.search}${location.hash}`, value));
            return;
          }
        }
        updateSummary(name);
      },
      { signal },
    );
    const estimatedDifficulty = settings.querySelector<HTMLElement & { selected: boolean }>("[data-difficulty-estimates]");
    const syncEstimatedDifficulty = () => {
      if (estimatedDifficulty) estimatedDifficulty.selected = difficultyEstimatesEnabled();
    };
    syncEstimatedDifficulty();
    stopDifficultyDisplay = observeDifficultyDisplay(syncEstimatedDifficulty);
    estimatedDifficulty?.addEventListener("change", () => {
      setDifficultyEstimatesEnabled(estimatedDifficulty.selected);
    }, { signal });
    const japanese = settings.querySelector<HTMLElement & { selected: boolean }>("[data-japanese-titles]");
    if (japanese) japanese.selected = japaneseSongTitles();
    japanese?.addEventListener(
      "change",
      () => {
        setJapaneseSongTitles(japanese.selected);
      },
      { signal },
    );
  };
  initializeSettings();
  document.addEventListener("astro:page-load", initializeSettings);
  document.addEventListener("astro:before-swap", () => disposeSettings?.());
</script>
