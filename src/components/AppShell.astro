---
import Icon from "./Icon.astro";
import I18nText from "./I18nText.astro";
import { NAV_SECTIONS, PRIMARY_DESTINATIONS, UTILITY_DESTINATIONS, INFORMATION_DESTINATIONS, isDestinationActive, isRouteActive } from "../config/navigation";
import { localePath, type Locale } from "../i18n/locales";
import { t } from "../i18n/messages";
import { resourceCollectionHref } from "../lib/resource-route";
import type { ReleaseServer } from "../lib/release-server";
import { publicForumNavigation } from "../server/public-forum-navigation";
import { serializePageData } from "../lib/page-data";
interface Props {
  locale: Locale;
  route: string;
  title: string;
  titleKey?: string;
  server?: ReleaseServer;
  appBar?: { actions: string; identity: string; search: string };
  contained?: boolean;
  entity?: {
    title: string;
    titleLanguage?: string;
    backHref: string;
    menuFirst?: boolean;
    previous?: { href: string; title?: string };
    next?: { href: string; title?: string };
  };
}
const { locale, route, title, titleKey, server, entity, appBar, contained = false } = Astro.props;
const shellTitle = entity?.title ?? title;
const shellTitleKey = entity ? undefined : titleKey;
const itemActive = (target: string) => target === "/community" ? ["/community", "/community/feeds"].includes(route) : isRouteActive(target, route);
const sectionActive = (section: { items: { route: string }[] }) => section.items.some((item) => itemActive(item.route));
const navigationServer = server?.startsWith("jp") ? "jp" : "intl";
const navigationHref = (target: string) => {
  if (target === "/") return `/${navigationServer}/${locale}/`;
  if (target === "/announcements") return `/${navigationServer}/${locale}/announcements/`;
  const resource = resourceCollectionHref(target, navigationServer, locale);
  if (resource) return resource;
  const href = localePath(target, locale);
  return server && target.startsWith("/catalog") ? `${href}?server=${navigationServer}` : href;
};
const navigation = PRIMARY_DESTINATIONS.map((destination) => ({
  ...destination,
  sections: NAV_SECTIONS.map((section) => ({
    ...section,
    items: section.items.filter((item) => isDestinationActive(destination, item.route)),
  })).filter((section) => section.items.length > 0),
}));
const utilities = UTILITY_DESTINATIONS;
const informationPages = INFORMATION_DESTINATIONS;
const hasSearch = Astro.slots.has("search");
const searchIndexable = !["/account", "/admin", "/settings", "/search", "/community"].some(prefix => route === prefix || route.startsWith(`${prefix}/`));
const inInformation = route === "/about" || informationPages.some((item) => itemActive(item.route));
const publicForums = await publicForumNavigation(locale, route);
const publicForumsDataId = "shell-public-forums";
---

<div class="app-shell" data-shell data-route={route}>
  <script is:inline type="application/json" id={publicForumsDataId} set:html={serializePageData(publicForums.snapshot)}></script>
  <a class="skip-link" href="#main-content">
    <I18nText keyName="common.fields.content" fallback="Content" locale={locale} />
  </a>
  <button
    class="nav-scrim"
    type="button"
    tabindex="-1"
    data-nav-close
    aria-label={t(locale, "common.actions.close", "Close")}
    data-i18n-aria-label="common.actions.close" data-i18n-aria-label-fallback="Close"
  ></button>

  <!--
    Material 3 Expressive navigation rail (WideNavigationRail).
    One element serves every window class:
      compact  <600    hidden; the menu button opens it as a modal expanded rail
      medium   600+    collapsed rail (96dp); the menu button opens the modal expanded rail
      expanded 1200+   persistent rail that the reader toggles between collapsed and expanded
    Primary destinations morph between the vertical item (56x32 indicator,
    label below) and the horizontal item (56dp full-width pill, label beside
    the icon); the icon keeps its x so the morph reads as one object. The current
    destination's tree is listed below it with collapsible branches, and
    account, settings and about are
    pinned at the bottom.
  -->
  <nav
    class="nav"
    id="global-navigation"
    aria-label={t(locale, "navigation.primaryNavigation", "Primary navigation")}
    data-i18n-aria-label="navigation.primaryNavigation" data-i18n-aria-label-fallback="Primary navigation"
    data-nav
  >
    <div class="nav__header">
      <button
        class="icon-button nav__toggle"
        type="button"
        data-nav-toggle
        aria-controls="global-navigation"
        aria-expanded="false"
        aria-label={t(locale, "navigation.menu", "Menu")}
        data-i18n-aria-label="navigation.menu" data-i18n-aria-label-fallback="Menu"
      >
        <span class="nav__toggle-icon" aria-hidden="true">
          <Icon name="menu" />
          <Icon name="menu_open" />
        </span>
      </button>
      <a class="nav__brand" href={navigationHref("/")} aria-label="haneoka">
        <img src="/favicon.svg" width="28" height="28" alt="" />
        <span>haneoka</span>
      </a>
    </div>

    <div class="nav__scroll" data-nav-scroll>
      <ul class="nav__destinations" role="list">
        {navigation.map((destination) => {
          const current = isDestinationActive(destination, route);
          const tree = destination.sections.length > 0;
          return (
            <li class="nav__destination" data-current={current ? "true" : undefined} data-destination={destination.id} data-open={tree && current ? "" : undefined}>
              <a
                class="rail-item"
                data-nav-route={destination.route}
                href={navigationHref(destination.route)}
                aria-current={current ? (route === destination.route ? "page" : "location") : undefined}
              >
                <span class="rail-item__indicator" aria-hidden="true"></span>
                <span class="rail-item__icon">
                  <Icon name={destination.icon} filled={current} />
                </span>
                <span class="rail-item__label">
                  <I18nText keyName={destination.label} fallback={destination.id} locale={locale} />
                </span>
              </a>
              {tree && (
                <button
                  class="icon-button nav__tree-toggle"
                  type="button"
                  data-nav-tree-toggle={destination.id}
                  aria-controls={`nav-tree-${destination.id}`}
                  aria-expanded={current ? "true" : "false"}
                >
                  <Icon name="expand_more" size={20} />
                  <span class="sr-only"><I18nText keyName={destination.label} fallback={destination.id} locale={locale} /></span>
                </button>
              )}
              {tree && (
                <div class="nav__tree" id={`nav-tree-${destination.id}`} data-nav-tree={destination.id}>
                  <div class="nav__tree-inner">
                    {destination.sections.map((section) => (
                      <section class="nav__section" aria-labelledby={destination.sections.length > 1 && !section.hideHeading ? `nav-section-${section.id}` : undefined}>
                        {destination.sections.length > 1 && !section.hideHeading && !section.collapsible && (
                          <h2 class="nav__headline" id={`nav-section-${section.id}`}>
                            <I18nText keyName={section.label} fallback={section.id} locale={locale} />
                          </h2>
                        )}
                        {section.collapsible && (
                          <h2 class="nav__headline nav__headline--toggle" id={`nav-section-${section.id}`}>
                            <button
                              class="nav__section-toggle"
                              type="button"
                              data-nav-section-toggle={section.id}
                              aria-expanded={sectionActive(section) ? "true" : "false"}
                              aria-controls={`nav-section-items-${section.id}`}
                            >
                              <span><I18nText keyName={section.label} fallback={section.id} locale={locale} /></span>
                              <Icon name="expand_more" size={20} />
                            </button>
                          </h2>
                        )}
                        <ul class="nav__items" role="list" id={`nav-section-items-${section.id}`} hidden={section.collapsible && !sectionActive(section)}>
                          {section.items.map((item) => {
                            const children = item.children || [];
                            const forums = destination.id === "community" && item.route === "/community/forums";
                            const active = itemActive(item.route);
                            const branch = children.length > 0 || forums;
                            const branchId = `nav-item${item.route.replaceAll("/", "-")}`;
                            const branchOpen = active || children.some(child => itemActive(child.route))
                              || (forums && route.startsWith("/community/forums/"));
                            return (
                              <li>
                                <div class="nav__item-row">
                                  <a class="nav-item" data-nav-route={item.route} href={navigationHref(item.route)} aria-current={active ? "page" : undefined}>
                                    <span class="nav-item__indicator" aria-hidden="true"></span>
                                    <Icon name={item.icon} size={20} filled={active} />
                                    <span class="nav-item__label"><I18nText keyName={item.label} fallback={item.label} locale={locale} /></span>
                                  </a>
                                  {branch && (
                                    <button class="icon-button nav__item-toggle" type="button"
                                      data-nav-section-toggle={branchId}
                                      aria-expanded={branchOpen ? "true" : "false"} aria-controls={branchId}>
                                      <Icon name="expand_more" size={20} />
                                      <span class="sr-only"><I18nText keyName={item.label} fallback={item.label} locale={locale} /></span>
                                    </button>
                                  )}
                                </div>
                                {children.length > 0 && (
                                  <ul class="nav__items nav__items--nested" role="list" id={branchId} hidden={!branchOpen}>
                                    {children.map((child) => (
                                      <li>
                                        <a class="nav-item" data-nav-route={child.route} href={navigationHref(child.route)} aria-current={itemActive(child.route) ? "page" : undefined}>
<span class="nav-item__indicator" aria-hidden="true"></span>
                                          <Icon name={child.icon} size={20} filled={itemActive(child.route)} />
                                          <span class="nav-item__label"><I18nText keyName={child.label} fallback={child.label} locale={locale} /></span>
                                        </a>
                                      </li>
                                    ))}
                                  </ul>
                                )}
                                {forums && (
                                  <div class="nav__items--nested nav__forums" id={branchId} hidden={!branchOpen}>
                                    <community-forum-navigation locale={locale} data-community-forum-directory
                                      data-prerendered data-page-data={publicForumsDataId} set:html={publicForums.body}
                                      transition:persist="community-forum-navigation"></community-forum-navigation>
                                  </div>
                                )}
                              </li>
                            );
                          })}
                        </ul>
                      </section>
                    ))}
                  </div>
                </div>
              )}
            </li>
          );
        })}
      </ul>
    </div>

    <!-- The music player lives here while it is collapsed (audio-dock.ts
         renders into this slot): a now-playing item in the rail. -->
    <div class="nav__player" data-nav-player transition:persist="navigation-player"></div>

    <ul class="nav__utilities" role="list">
      {utilities.map((item) => {
        const active = itemActive(item.route) || (item.route === "/about" && inInformation);
        return (
          <li class="nav__destination" data-current={active ? "true" : undefined}>
            <a
              class="rail-item rail-item--utility"
              data-nav-route={item.route}
              href={navigationHref(item.route)}
              aria-current={itemActive(item.route) ? "page" : active ? "location" : undefined}
            >
              <span class="rail-item__indicator" aria-hidden="true"></span>
              <span class="rail-item__icon">
                <Icon name={item.icon} filled={active} />
              </span>
              <span class="rail-item__label">
                <I18nText keyName={item.label} fallback={item.label} locale={locale} />
              </span>
            </a>
            {item.route === "/about" && inInformation && (
              <div class="nav__tree">
                <div class="nav__tree-inner">
                  <ul class="nav__items" role="list">
                    {informationPages.map((page) => (
                      <li>
                        <a class="nav-item" data-nav-route={page.route} href={navigationHref(page.route)} aria-current={itemActive(page.route) ? "page" : undefined}>
<span class="nav-item__indicator" aria-hidden="true"></span>
                          <span class="nav-item__label"><I18nText keyName={page.label} fallback={page.label} locale={locale} /></span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            )}
          </li>
        );
      })}
    </ul>
  </nav>

  <div class="app-shell__body">
    <header class="top-app-bar" data-top-app-bar>
      <div class="top-app-bar__leading" data-top-app-bar-leading>
        {entity ? (
          <a
            class="icon-button"
            href={entity.backHref}
            data-entity-back
            data-entity-fallback-href={entity.backHref}
            aria-label={t(locale, "common.actions.back", "Back")}
            data-i18n-aria-label="common.actions.back"
          >
            <Icon name="arrow_back" />
          </a>
        ) : (
          <button
            class="icon-button top-app-bar__menu"
            type="button"
            data-nav-toggle
            aria-controls="global-navigation"
            aria-expanded="false"
            aria-label={t(locale, "navigation.menu", "Menu")}
            data-i18n-aria-label="navigation.menu" data-i18n-aria-label-fallback="Menu"
          >
            <Icon name="menu" />
          </button>
        )}
      </div>
      <h1
        hidden={hasSearch}
        data-pagefind-meta="title"
        data-entity-title={entity ? "true" : undefined}
        lang={entity?.titleLanguage}
      >{shellTitleKey ? <I18nText keyName={shellTitleKey} fallback={shellTitle} locale={locale} /> : shellTitle}</h1>
      <!-- An entity's identity marks (band logo, attribute, rarity) follow its
           title: they arrive after hydration, and after the title they can
           appear without moving it. -->
      <div class="top-app-bar__identity" data-top-app-bar-identity set:html={appBar?.identity || ""}></div>
      <slot name="search" />
      <!-- The trailing row fills the rest of the bar and packs its controls
           to the end, so controls that arrive after hydration never move the
           row's box. Compact windows have no rail: the collapsed player's
           now-playing button sits at the start of this row. -->
      <div class="top-app-bar__actions" data-top-app-bar-actions>
        {appBar && <Fragment set:html={appBar.search} />}
        {entity?.menuFirst && <div class="top-app-bar__group" data-entity-menu-first-group><button class="icon-button top-app-bar__menu" type="button" data-entity-menu-first data-nav-toggle aria-controls="global-navigation" aria-expanded="false" aria-label={t(locale, "navigation.menu", "Menu")} data-i18n-aria-label="navigation.menu" data-i18n-aria-label-fallback="Menu"><Icon name="menu" /></button></div>}
        <div class="top-app-bar__player" data-app-bar-player></div>
        {appBar && <Fragment set:html={appBar.actions} />}
        {entity && (!entity.menuFirst || entity.previous || entity.next) && (
          <div class="top-app-bar__secondary-actions">
            {!entity.menuFirst && <button
              class="icon-button top-app-bar__menu"
              type="button"
              data-app-bar-overflow-compact
              data-nav-toggle
              aria-controls="global-navigation"
              aria-expanded="false"
              aria-label={t(locale, "navigation.menu", "Menu")}
              data-i18n-aria-label="navigation.menu" data-i18n-aria-label-fallback="Menu"
            >
              <Icon name="menu" />
            </button>}
            {entity.previous && (
              <a
                class="icon-button"
                href={entity.previous.href}
                data-entity-navigation="previous"
                data-entity-base-href={entity.previous.href}
                aria-label={`${t(locale, "common.actions.previous", "Previous")}${entity.previous.title ? `: ${entity.previous.title}` : ""}`}
              >
                <Icon name="chevron_left" />
              </a>
            )}
            {entity.next && (
              <a
                class="icon-button"
                href={entity.next.href}
                data-entity-navigation="next"
                data-entity-base-href={entity.next.href}
                aria-label={`${t(locale, "common.actions.next", "Next")}${entity.next.title ? `: ${entity.next.title}` : ""}`}
              >
                <Icon name="chevron_right" />
              </a>
            )}
          </div>
        )}
      </div>
    </header>
    <div class="app-shell__progress" data-page-progress data-page-progress-active="false" aria-hidden="true">
      <md-linear-progress
        data-page-progress-control
        indeterminate
        aria-label={t(locale, "common.states.loading", "Loading")}
        data-i18n-aria-label="common.states.loading" data-i18n-aria-label-fallback="Loading"
      ></md-linear-progress>
      <span class="app-shell__progress-fallback" data-page-progress-fallback aria-hidden="true"></span>
      <span class="app-shell__progress-status" data-page-progress-status role="status" aria-live="polite"></span>
    </div>
    <main class:list={["app-shell__main page-stage", { "app-shell__main--contained": contained }]} id="main-content" tabindex="-1" data-pagefind-body={searchIndexable ? "" : undefined}>
      <slot />
    </main>
  </div>
</div>
<script>
  import "@lit-labs/ssr-client/lit-element-hydrate-support.js";
  import "../lit/community-forum-navigation";
  import { trapFocus } from "../lib/overlay";
  import { syncEntityNavigation } from "../lib/detail-navigation";
  import { fitAppBarActions } from "../lib/app-bar-overflow";
  import { readSelectedReleaseServer } from "../lib/release-server";
  const EXPANDED_KEY = "haneoka.navigation.expanded.v2";
  const SCROLL_KEY = "haneoka.navigation.scroll.v3";
  const OPEN_KEY = "haneoka.navigation.open.v1";
  const persistentQuery = matchMedia("(min-width: 1200px)");
  const root = document.documentElement;
  let releaseNavigationFocus: (() => void) | undefined;
  let releaseActionObservers: (() => void) | undefined;
  const inertTargets = new Set<HTMLElement>();
  let navigationScroll: number | undefined;
  let navigationAnchor: { route: string; offset: number } | undefined;

  const shell = () => document.querySelector<HTMLElement>("[data-shell]");
  const syncToggles = (expanded: boolean) =>
    document
      .querySelectorAll("[data-nav-toggle]")
      .forEach((node) => node.setAttribute("aria-expanded", String(expanded)));

  /** Below 1200px the expanded rail is modal: it slides over a scrim and the page goes inert. */
  const setModal = (open: boolean) => {
    const host = shell();
    if (!host) return;
    if (host.classList.contains("nav-modal-open") === open && (open || !releaseNavigationFocus)) {
      syncToggles(open || (persistentQuery.matches && root.dataset.nav !== "collapsed"));
      return;
    }
    host.classList.toggle("nav-modal-open", open);
    if (open) {
      for (const target of document.querySelectorAll<HTMLElement>(".app-shell__body, audio-dock")) {
        if (!target.inert) {
          target.inert = true;
          inertTargets.add(target);
        }
      }
      const navigation = host.querySelector<HTMLElement>("[data-nav]");
      if (navigation && !releaseNavigationFocus)
        releaseNavigationFocus = trapFocus(navigation, {
          onDismiss: () => setModal(false),
          initialFocus: navigation.querySelector<HTMLElement>(
            ".nav-item[aria-current='page'], .rail-item[aria-current], .rail-item",
          ),
        });
    } else {
      for (const target of inertTargets) target.inert = false;
      inertTargets.clear();
      releaseNavigationFocus?.();
      releaseNavigationFocus = undefined;
    }
    syncToggles(open || (persistentQuery.matches && root.dataset.nav !== "collapsed"));
  };
  const setPersistent = (expanded: boolean) => {
    root.dataset.nav = expanded ? "expanded" : "collapsed";
    try {
      localStorage.setItem(EXPANDED_KEY, String(expanded));
    } catch {}
    syncToggles(expanded);
  };
  const readNavigationChoices = (): Record<string, boolean> => {
    try { return JSON.parse(localStorage.getItem(OPEN_KEY) || "{}") || {}; }
    catch { return {}; }
  };
  const setTreeOpen = (item: HTMLElement, open: boolean) => {
    item.toggleAttribute("data-open", open);
    item.querySelector("[data-nav-tree-toggle]")?.setAttribute("aria-expanded", String(open));
  };
  const restoreNavigationChoices = (host: ParentNode, opened = readNavigationChoices()) => {
    host.querySelectorAll<HTMLElement>(".nav__destinations [data-nav-tree-toggle]").forEach((toggle) => {
      const id = toggle.dataset.navTreeToggle!;
      if (id in opened) setTreeOpen(toggle.closest<HTMLElement>(".nav__destination")!, opened[id] === true);
    });
    host.querySelectorAll<HTMLElement>("[data-nav-section-toggle]").forEach((toggle) => {
      const id = `section:${toggle.dataset.navSectionToggle}`;
      const items = host.querySelector<HTMLElement>(`#${CSS.escape(toggle.getAttribute("aria-controls")!)}`)!;
      if (id in opened && !items.querySelector("[aria-current]")) {
        toggle.setAttribute("aria-expanded", String(opened[id] === true));
        items.hidden = opened[id] !== true;
      }
    });
  };
  const indicatorVisible = (host: ParentNode): boolean => {
    const indicator = [...host.querySelectorAll<HTMLElement>(".rail-item__indicator, .nav-item__indicator")]
      .find((item) => getComputedStyle(item).viewTransitionName === "nav-indicator");
    if (!indicator) return false;
    const clip = indicator.closest<HTMLElement>("[data-nav-scroll]") ?? indicator.closest<HTMLElement>("[data-nav]")!;
    const box = clip.getBoundingClientRect(), item = indicator.getBoundingClientRect();
    return item.top >= box.top && item.bottom <= box.bottom;
  };

  const initializeShell = () => {
    const host = shell();
    if (!host || host.dataset.initialized === "true") return;
    readSelectedReleaseServer();
    host.dataset.initialized = "true";
    const navigation = host.querySelector<HTMLElement>("[data-nav]")!;
    navigation.dataset.navRestoring = "true";
    const opened = readNavigationChoices();
    restoreNavigationChoices(host, opened);
    syncToggles(persistentQuery.matches && root.dataset.nav !== "collapsed");
    host.querySelectorAll("[data-nav-toggle]").forEach((node) =>
      node.addEventListener("click", () => {
        if (persistentQuery.matches) setPersistent(root.dataset.nav === "collapsed");
        else setModal(!host.classList.contains("nav-modal-open"));
      }),
    );
    host.querySelectorAll("[data-nav-close]").forEach((node) => node.addEventListener("click", () => setModal(false)));

    const scroller = host.querySelector<HTMLElement>("[data-nav-scroll]");
    let savedScroll = navigationScroll;
    try {
      const saved = sessionStorage.getItem(SCROLL_KEY);
      if (savedScroll === undefined && saved !== null) savedScroll = Number(saved);
    } catch {}
    navigationScroll = undefined;
    if (scroller && savedScroll !== undefined) scroller.scrollTop = savedScroll;
    if (scroller && navigationAnchor) {
      const anchor = scroller.querySelector<HTMLElement>(`[data-nav-route="${CSS.escape(navigationAnchor.route)}"]`);
      if (anchor && !anchor.closest("[hidden]") && getComputedStyle(anchor).visibility === "visible")
        scroller.scrollTop += anchor.getBoundingClientRect().top - scroller.getBoundingClientRect().top - navigationAnchor.offset;
    }
    navigationAnchor = undefined;
    const currentEntry = scroller?.querySelector<HTMLElement>(".nav-item[aria-current='page']");
    if (savedScroll === undefined && scroller && currentEntry && scroller.clientHeight > 0 &&
      getComputedStyle(currentEntry).visibility === "visible") {
      const box = scroller.getBoundingClientRect();
      const entry = currentEntry.getBoundingClientRect();
      if (entry.top < box.top + 8) scroller.scrollTop += entry.top - box.top - 8;
      else if (entry.bottom > box.bottom - 8) scroller.scrollTop += entry.bottom - box.bottom + 8;
    }
    navigation.getBoundingClientRect();
    if (!indicatorVisible(host)) root.setAttribute("data-nav-indicator-static", "");
    try { if (scroller) sessionStorage.setItem(SCROLL_KEY, String(scroller.scrollTop)); } catch {}
    requestAnimationFrame(() => {
      navigation.removeAttribute("data-nav-restoring");
    });
    scroller?.addEventListener(
      "scroll",
      () => {
        if (!navigation.isConnected || navigation.hasAttribute("data-nav-restoring")) return;
        try {
          sessionStorage.setItem(SCROLL_KEY, String(scroller.scrollTop));
        } catch {}
      },
      { passive: true },
    );
    host.querySelectorAll<HTMLElement>(".nav__destinations [data-nav-tree-toggle]").forEach((toggle) => {
      const item = toggle.closest<HTMLElement>(".nav__destination")!;
      const id = toggle.dataset.navTreeToggle!;
      toggle.addEventListener("click", () => {
        const open = !item.hasAttribute("data-open");
        setTreeOpen(item, open);
        opened[id] = open;
        try {
          localStorage.setItem(OPEN_KEY, JSON.stringify(opened));
        } catch {}
      });
    });
    host.querySelectorAll<HTMLElement>("[data-nav-section-toggle]").forEach((toggle) => {
      const id = `section:${toggle.dataset.navSectionToggle}`;
      const items = document.getElementById(toggle.getAttribute("aria-controls")!)!;
      const set = (open: boolean) => {
        toggle.setAttribute("aria-expanded", String(open));
        items.hidden = !open;
      };
      toggle.addEventListener("click", () => {
        const open = toggle.getAttribute("aria-expanded") !== "true";
        set(open);
        opened[id] = open;
        try {
          localStorage.setItem(OPEN_KEY, JSON.stringify(opened));
        } catch {}
      });
    });

    // Material top app bar: the container switches to the "on scroll" surface once content scrolls under it.
    const bar = host.querySelector<HTMLElement>("[data-top-app-bar]");
    const main = host.querySelector<HTMLElement>("#main-content");
    let scrolled: boolean | undefined;
    const syncScrollSurface = () => {
      const next = (main?.scrollTop ?? 0) > 2;
      if (next === scrolled) return;
      scrolled = next;
      bar?.classList.toggle("is-scrolled", next);
    };
    main?.addEventListener("scroll", syncScrollSurface, { passive: true });
    syncScrollSurface();

    // The trailing row overflows its lowest-priority actions into a menu
    // when they do not fit beside the title. Lit replaces this subtree as
    // entities load, so watch both its box and its children.
    const actions = host.querySelector<HTMLElement>("[data-top-app-bar-actions]");
    let fitting = false;
    const syncActionOverflow = () => {
      if (!actions || !bar || fitting) return;
      fitting = true;
      try {
        const identity = bar.querySelector<HTMLElement>("[data-top-app-bar-identity]");
        if (identity) identity.hidden = false;
        fitAppBarActions(bar, actions);
        // Identity marks go before any further squeeze of the title.
        const title = bar.querySelector<HTMLElement>("h1");
        // (A short title is not a squeezed one: only a truncated title under
        // 96px gives up the marks.)
        if (identity && !identity.querySelector(".browse__crumbs") && title && title.scrollWidth > title.clientWidth + 1 && title.getBoundingClientRect().width < 96)
          identity.hidden = true;
        actions.dataset.appBarOverflow = "false";
      } finally {
        fitting = false;
      }
    };
    if (actions && bar) {
      releaseActionObservers?.();
      const resizeObserver = new ResizeObserver(syncActionOverflow);
      const mutationObserver = new MutationObserver(syncActionOverflow);
      resizeObserver.observe(bar);
      resizeObserver.observe(actions);
      const playerSlot = bar.querySelector<HTMLElement>("[data-app-bar-player]");
      if (playerSlot) resizeObserver.observe(playerSlot);
      mutationObserver.observe(bar, { childList: true, subtree: true });
      actions.addEventListener("scroll", syncActionOverflow, { passive: true });
      releaseActionObservers = () => {
        resizeObserver.disconnect();
        mutationObserver.disconnect();
        actions.removeEventListener("scroll", syncActionOverflow);
      };
      syncActionOverflow();
    }
  };

  initializeShell();
  syncEntityNavigation();
  document.addEventListener("astro:page-load", syncEntityNavigation);
  document.addEventListener("astro:page-load", initializeShell);
  document.addEventListener("astro:after-swap", initializeShell);
  persistentQuery.addEventListener("change", () => setModal(false));
  document.addEventListener("astro:before-swap", (event) => {
    const next = (event as Event & { newDocument: Document }).newDocument;
    next.documentElement.toggleAttribute("data-nav-indicator-static", !indicatorVisible(document));
    navigationAnchor = undefined;
    const scroller = shell()?.querySelector<HTMLElement>("[data-nav-scroll]");
    if (scroller) {
      navigationScroll = scroller.scrollTop;
      try { sessionStorage.setItem(SCROLL_KEY, String(navigationScroll)); } catch {}
      const nextScroller = next.querySelector<HTMLElement>("[data-nav-scroll]");
      const destination = nextScroller?.querySelector<HTMLElement>(".nav-item[aria-current='page'][data-nav-route]") ??
        nextScroller?.querySelector<HTMLElement>(".rail-item[aria-current][data-nav-route]");
      const target = destination?.dataset.navRoute && scroller.querySelector<HTMLElement>(`[data-nav-route="${CSS.escape(destination.dataset.navRoute)}"]`);
      const anchor = target || scroller.querySelector<HTMLElement>(".nav-item[aria-current='page'][data-nav-route]");
      if (anchor && !anchor.closest("[hidden]") && getComputedStyle(anchor).visibility === "visible") {
        const box = scroller.getBoundingClientRect(), item = anchor.getBoundingClientRect();
        if (item.bottom > box.top && item.top < box.bottom)
          navigationAnchor = { route: anchor.dataset.navRoute!, offset: item.top - box.top };
      }
    }
    restoreNavigationChoices(next);
    next.querySelector<HTMLElement>("[data-nav]")?.setAttribute("data-nav-restoring", "true");
    setModal(false);
    releaseActionObservers?.();
    releaseActionObservers = undefined;
  });
</script>
