---
import Icon from "./Icon.astro";
import I18nText from "./I18nText.astro";
import { NAV_SECTIONS, PRIMARY_DESTINATIONS, UTILITY_DESTINATIONS, INFORMATION_DESTINATIONS, isDestinationActive, isRouteActive } from "../config/navigation";
import { localePath, type Locale } from "../i18n/locales";
import { t } from "../i18n/messages";
import { resourceCollectionHref } from "../lib/resource-route";
import type { ReleaseServer } from "../lib/release-server";
interface Props {
  locale: Locale;
  route: string;
  title: string;
  titleKey?: string;
  server?: ReleaseServer;
  entity?: {
    title: string;
    titleLanguage?: string;
    backHref: string;
    previous?: { href: string; title?: string };
    next?: { href: string; title?: string };
  };
}
const { locale, route, title, titleKey, server, entity } = Astro.props;
const shellTitle = entity?.title ?? title;
const shellTitleKey = entity ? undefined : titleKey;
const itemActive = (target: string) => target === "/community" ? ["/community", "/community/feeds"].includes(route) : isRouteActive(target, route);
const navigationHref = (target: string) => {
  if (target === "/") return `/${server ?? "intl"}/${locale}/`;
  if (target === "/announcements") return `/${server ?? "intl"}/${locale}/announcements/`;
  const resource = resourceCollectionHref(target, server ?? "intl", locale);
  if (resource) return resource;
  const href = localePath(target, locale);
  return server && target.startsWith("/catalog") ? `${href}?server=${server}` : href;
};
const navigation = PRIMARY_DESTINATIONS.map((destination) => ({
  ...destination,
  sections: NAV_SECTIONS.map((section) => ({
    ...section,
    items: section.items.filter((item) => isDestinationActive(destination, item.route)),
  })).filter((section) => section.items.length > 0),
}));
const utilities = UTILITY_DESTINATIONS;
const informationPages = INFORMATION_DESTINATIONS;
const hasSearch = Astro.slots.has("search");
const searchIndexable = !["/account", "/admin", "/settings", "/search", "/community"].some(prefix => route === prefix || route.startsWith(`${prefix}/`));
const inInformation = route === "/about" || informationPages.some((item) => itemActive(item.route));
---

<div class="app-shell" data-shell data-route={route}>
  <a class="skip-link" href="#main-content">
    <I18nText keyName="content" fallback="Content" locale={locale} />
  </a>
  <button
    class="nav-scrim"
    type="button"
    tabindex="-1"
    data-nav-close
    aria-label={t(locale, "close", "Close")}
    data-i18n-aria-label="close" data-i18n-aria-label-fallback="Close"
  ></button>

  <!--
    Material 3 Expressive navigation rail (WideNavigationRail).
    One element serves every window class:
      compact  <600    hidden; the menu button opens it as a modal expanded rail
      medium   600+    collapsed rail (96dp); the menu button opens the modal expanded rail
      expanded 1200+   persistent rail that the reader toggles between collapsed and expanded
    Primary destinations morph between the vertical item (56x32 indicator,
    label below) and the horizontal item (56dp full-width pill, label beside
    the icon); the icon keeps its x so the morph reads as one object. The current
    destination's whole tree is listed below it — every level visible and
    indented, nothing to disclose — and account, settings and about are
    pinned at the bottom.
  -->
  <nav
    class="nav"
    id="global-navigation"
    aria-label={t(locale, "primaryNavigation", "Primary navigation")}
    data-i18n-aria-label="primaryNavigation" data-i18n-aria-label-fallback="Primary navigation"
    data-nav
  >
    <div class="nav__header">
      <button
        class="icon-button nav__toggle"
        type="button"
        data-nav-toggle
        aria-controls="global-navigation"
        aria-expanded="false"
        aria-label={t(locale, "menu", "Menu")}
        data-i18n-aria-label="menu" data-i18n-aria-label-fallback="Menu"
      >
        <span class="nav__toggle-icon" aria-hidden="true">
          <Icon name="menu" />
          <Icon name="menu_open" />
        </span>
      </button>
      <a class="nav__brand" href={navigationHref("/")} aria-label="haneoka">
        <img src="/favicon.svg" width="28" height="28" alt="" />
        <span>haneoka</span>
      </a>
    </div>

    <div class="nav__scroll" data-nav-scroll>
      <ul class="nav__destinations" role="list">
        {navigation.map((destination) => {
          const current = isDestinationActive(destination, route);
          return (
            <li class="nav__destination" data-current={current ? "true" : undefined} data-destination={destination.id}>
              <a
                class="rail-item"
                href={navigationHref(destination.route)}
                aria-current={current ? (route === destination.route ? "page" : "location") : undefined}
              >
                <span class="rail-item__indicator" aria-hidden="true"></span>
                <span class="rail-item__icon">
                  <Icon name={destination.icon} filled={current} />
                </span>
                <span class="rail-item__label">
                  <I18nText keyName={destination.label} fallback={destination.id} locale={locale} />
                </span>
              </a>
              {current && destination.sections.length > 0 && (
                <div class="nav__tree" data-nav-tree={destination.id}>
                  <div class="nav__tree-inner">
                    {destination.sections.map((section) => (
                      <section class="nav__section" aria-labelledby={destination.sections.length > 1 ? `nav-section-${section.id}` : undefined}>
                        {destination.sections.length > 1 && (
                          <h2 class="nav__headline" id={`nav-section-${section.id}`}>
                            <I18nText keyName={section.label} fallback={section.id} locale={locale} />
                          </h2>
                        )}
                        <ul class="nav__items" role="list">
                          {section.items.map((item) => {
                            const children = item.children || [];
                            const forums = destination.id === "community" && item.route === "/community/forums";
                            const active = itemActive(item.route);
                            return (
                              <li>
                                <a class="nav-item" href={navigationHref(item.route)} aria-current={active ? "page" : undefined}>
<span class="nav-item__indicator" aria-hidden="true"></span>
                                  <Icon name={item.icon} size={20} filled={active} />
                                  <span class="nav-item__label"><I18nText keyName={item.label} fallback={item.label} locale={locale} /></span>
                                </a>
                                {children.length > 0 && (
                                  <ul class="nav__items nav__items--nested" role="list">
                                    {children.map((child) => (
                                      <li>
                                        <a class="nav-item" href={navigationHref(child.route)} aria-current={itemActive(child.route) ? "page" : undefined}>
<span class="nav-item__indicator" aria-hidden="true"></span>
                                          <Icon name={child.icon} size={20} filled={itemActive(child.route)} />
                                          <span class="nav-item__label"><I18nText keyName={child.label} fallback={child.label} locale={locale} /></span>
                                        </a>
                                      </li>
                                    ))}
                                  </ul>
                                )}
                                {forums && (
                                  <div class="nav__items--nested nav__forums">
                                    <community-forum-navigation locale={locale} data-community-forum-directory
                                      transition:persist="community-forum-navigation"></community-forum-navigation>
                                  </div>
                                )}
                              </li>
                            );
                          })}
                        </ul>
                      </section>
                    ))}
                  </div>
                </div>
              )}
            </li>
          );
        })}
      </ul>
    </div>

    <!-- The music player lives here while it is collapsed (audio-dock.ts
         renders into this slot): a now-playing item in the rail. -->
    <div class="nav__player" data-nav-player></div>

    <ul class="nav__utilities" role="list">
      {utilities.map((item) => {
        const active = itemActive(item.route) || (item.route === "/about" && inInformation);
        return (
          <li class="nav__destination" data-current={active ? "true" : undefined}>
            <a
              class="rail-item rail-item--utility"
              href={navigationHref(item.route)}
              aria-current={itemActive(item.route) ? "page" : active ? "location" : undefined}
            >
              <span class="rail-item__indicator" aria-hidden="true"></span>
              <span class="rail-item__icon">
                <Icon name={item.icon} filled={active} />
              </span>
              <span class="rail-item__label">
                <I18nText keyName={item.label} fallback={item.label} locale={locale} />
              </span>
            </a>
            {item.route === "/about" && inInformation && (
              <div class="nav__tree">
                <div class="nav__tree-inner">
                  <ul class="nav__items" role="list">
                    {informationPages.map((page) => (
                      <li>
                        <a class="nav-item" href={navigationHref(page.route)} aria-current={itemActive(page.route) ? "page" : undefined}>
<span class="nav-item__indicator" aria-hidden="true"></span>
                          <span class="nav-item__label"><I18nText keyName={page.label} fallback={page.label} locale={locale} /></span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            )}
          </li>
        );
      })}
    </ul>
  </nav>

  <div class="app-shell__body">
    <header class="top-app-bar" data-top-app-bar>
      <div class="top-app-bar__leading" data-top-app-bar-leading>
        {entity ? (
          <a
            class="icon-button"
            href={entity.backHref}
            data-entity-back
            data-entity-fallback-href={entity.backHref}
            aria-label={t(locale, "back", "Back")}
            data-i18n-aria-label="back"
          >
            <Icon name="arrow_back" />
          </a>
        ) : (
          <button
            class="icon-button top-app-bar__menu"
            type="button"
            data-nav-toggle
            aria-controls="global-navigation"
            aria-expanded="false"
            aria-label={t(locale, "menu", "Menu")}
            data-i18n-aria-label="menu" data-i18n-aria-label-fallback="Menu"
          >
            <Icon name="menu" />
          </button>
        )}
      </div>
      <h1
        hidden={hasSearch}
        data-pagefind-meta="title"
        data-entity-title={entity ? "true" : undefined}
        lang={entity?.titleLanguage}
      >{shellTitleKey ? <I18nText keyName={shellTitleKey} fallback={shellTitle} locale={locale} /> : shellTitle}</h1>
      <!-- An entity's identity marks (band logo, attribute, rarity) follow its
           title: they arrive after hydration, and after the title they can
           appear without moving it. -->
      {entity && <div class="top-app-bar__identity" data-top-app-bar-identity></div>}
      <slot name="search" />
      <!-- The trailing row fills the rest of the bar and packs its controls
           to the end, so controls that arrive after hydration never move the
           row's box. Compact windows have no rail: the collapsed player's
           now-playing button sits at the start of this row. -->
      <div class="top-app-bar__actions" data-top-app-bar-actions>
        <div class="top-app-bar__player" data-app-bar-player></div>
        {entity && (
          <div class="top-app-bar__secondary-actions">
            <button
              class="icon-button top-app-bar__menu"
              type="button"
              data-app-bar-overflow-compact
              data-nav-toggle
              aria-controls="global-navigation"
              aria-expanded="false"
              aria-label={t(locale, "menu", "Menu")}
              data-i18n-aria-label="menu" data-i18n-aria-label-fallback="Menu"
            >
              <Icon name="menu" />
            </button>
            {entity.previous && (
              <a
                class="icon-button"
                href={entity.previous.href}
                data-entity-navigation="previous"
                data-entity-base-href={entity.previous.href}
                aria-label={`${t(locale, "previous", "Previous")}${entity.previous.title ? `: ${entity.previous.title}` : ""}`}
              >
                <Icon name="chevron_left" />
              </a>
            )}
            {entity.next && (
              <a
                class="icon-button"
                href={entity.next.href}
                data-entity-navigation="next"
                data-entity-base-href={entity.next.href}
                aria-label={`${t(locale, "next", "Next")}${entity.next.title ? `: ${entity.next.title}` : ""}`}
              >
                <Icon name="chevron_right" />
              </a>
            )}
          </div>
        )}
      </div>
    </header>
    <div class="app-shell__progress" data-page-progress data-page-progress-active="false" aria-hidden="true">
      <md-linear-progress
        data-page-progress-control
        indeterminate
        aria-label={t(locale, "loading", "Loading")}
        data-i18n-aria-label="loading" data-i18n-aria-label-fallback="Loading"
      ></md-linear-progress>
      <span class="app-shell__progress-fallback" data-page-progress-fallback aria-hidden="true"></span>
      <span class="app-shell__progress-status" data-page-progress-status role="status" aria-live="polite"></span>
    </div>
    <main class="app-shell__main page-stage" id="main-content" tabindex="-1" data-pagefind-body={searchIndexable ? "" : undefined}>
      <slot />
    </main>
  </div>
</div>
<script>
  import "../lit/community-forum-navigation";
  import { trapFocus } from "../lib/overlay";
  import { syncEntityNavigation } from "../lib/detail-navigation";
  import { fitAppBarActions } from "../lib/app-bar-overflow";
  const EXPANDED_KEY = "haneoka.navigation.expanded.v2";
  const SCROLL_KEY = "haneoka.navigation.scroll.v3";
  const TREE_KEY = "haneoka.navigation.tree.v1";
  const persistentQuery = matchMedia("(min-width: 1200px)");
  const root = document.documentElement;
  let releaseNavigationFocus: (() => void) | undefined;
  let releaseActionObservers: (() => void) | undefined;
  const inertTargets = new Set<HTMLElement>();

  const shell = () => document.querySelector<HTMLElement>("[data-shell]");
  const syncToggles = (expanded: boolean) =>
    document
      .querySelectorAll("[data-nav-toggle]")
      .forEach((node) => node.setAttribute("aria-expanded", String(expanded)));

  /** Below 1200px the expanded rail is modal: it slides over a scrim and the page goes inert. */
  const setModal = (open: boolean) => {
    const host = shell();
    if (!host) return;
    if (host.classList.contains("nav-modal-open") === open && (open || !releaseNavigationFocus)) {
      syncToggles(open || (persistentQuery.matches && root.dataset.nav !== "collapsed"));
      return;
    }
    host.classList.toggle("nav-modal-open", open);
    if (open) {
      for (const target of document.querySelectorAll<HTMLElement>(".app-shell__body, audio-dock")) {
        if (!target.inert) {
          target.inert = true;
          inertTargets.add(target);
        }
      }
      const navigation = host.querySelector<HTMLElement>("[data-nav]");
      if (navigation && !releaseNavigationFocus)
        releaseNavigationFocus = trapFocus(navigation, {
          onDismiss: () => setModal(false),
          initialFocus: navigation.querySelector<HTMLElement>(
            ".nav-item[aria-current='page'], .rail-item[aria-current], .rail-item",
          ),
        });
    } else {
      for (const target of inertTargets) target.inert = false;
      inertTargets.clear();
      releaseNavigationFocus?.();
      releaseNavigationFocus = undefined;
    }
    syncToggles(open || (persistentQuery.matches && root.dataset.nav !== "collapsed"));
  };
  const setPersistent = (expanded: boolean) => {
    root.dataset.nav = expanded ? "expanded" : "collapsed";
    try {
      localStorage.setItem(EXPANDED_KEY, String(expanded));
    } catch {}
    syncToggles(expanded);
  };

  const initializeShell = () => {
    const host = shell();
    if (!host || host.dataset.initialized === "true") return;
    host.dataset.initialized = "true";
    syncToggles(persistentQuery.matches && root.dataset.nav !== "collapsed");
    host.querySelectorAll("[data-nav-toggle]").forEach((node) =>
      node.addEventListener("click", () => {
        if (persistentQuery.matches) setPersistent(root.dataset.nav === "collapsed");
        else setModal(!host.classList.contains("nav-modal-open"));
      }),
    );
    host.querySelectorAll("[data-nav-close]").forEach((node) => node.addEventListener("click", () => setModal(false)));

    // Keep the rail's scroll position across page swaps so a long tree never
    // jumps, then bring the current entry on screen if it is not.
    const scroller = host.querySelector<HTMLElement>("[data-nav-scroll]");
    try {
      if (scroller) scroller.scrollTop = Number(sessionStorage.getItem(SCROLL_KEY) || 0);
    } catch {}
    const currentEntry = scroller?.querySelector<HTMLElement>(".nav-item[aria-current='page']");
    if (scroller && currentEntry && scroller.clientHeight > 0) {
      const box = scroller.getBoundingClientRect();
      const entry = currentEntry.getBoundingClientRect();
      if (entry.top < box.top + 8 || entry.bottom > box.bottom - 8)
        scroller.scrollTop += entry.top - box.top - box.height / 3;
    }
    scroller?.addEventListener(
      "scroll",
      () => {
        try {
          sessionStorage.setItem(SCROLL_KEY, String(scroller.scrollTop));
        } catch {}
      },
      { passive: true },
    );
    // A destination's tree unfolds when the reader arrives from another
    // destination; moving within one destination leaves it still.
    const tree = host.querySelector<HTMLElement>(".nav__destinations [data-nav-tree]");
    let previousTree: string | null = null;
    try {
      previousTree = sessionStorage.getItem(TREE_KEY);
      sessionStorage.setItem(TREE_KEY, tree?.dataset.navTree ?? "");
    } catch {}
    if (tree && previousTree !== null && previousTree !== tree.dataset.navTree) {
      tree.classList.add("nav__tree--entering");
      window.setTimeout(() => tree.classList.remove("nav__tree--entering"), 800);
    }

    // Material top app bar: the container switches to the "on scroll" surface once content scrolls under it.
    const bar = host.querySelector<HTMLElement>("[data-top-app-bar]");
    const main = host.querySelector<HTMLElement>("#main-content");
    let frame = 0;
    main?.addEventListener(
      "scroll",
      (event) => {
        if (frame) return;
        const target = event.target as HTMLElement;
        frame = requestAnimationFrame(() => {
          frame = 0;
          bar?.classList.toggle("is-scrolled", target.scrollTop > 2);
        });
      },
      { capture: true, passive: true },
    );

    // The trailing row overflows its lowest-priority actions into a menu
    // when they do not fit beside the title. Lit replaces this subtree as
    // entities load, so watch both its box and its children.
    const actions = host.querySelector<HTMLElement>("[data-top-app-bar-actions]");
    let fitting = false;
    const syncActionOverflow = () => {
      if (!actions || !bar || fitting) return;
      fitting = true;
      try {
        const identity = bar.querySelector<HTMLElement>("[data-top-app-bar-identity]");
        if (identity) identity.hidden = false;
        fitAppBarActions(bar, actions);
        // Identity marks go before any further squeeze of the title.
        const title = bar.querySelector<HTMLElement>("h1");
        // (A short title is not a squeezed one: only a truncated title under
        // 96px gives up the marks.)
        if (identity && title && title.scrollWidth > title.clientWidth + 1 && title.getBoundingClientRect().width < 96)
          identity.hidden = true;
        actions.dataset.appBarOverflow = "false";
      } finally {
        fitting = false;
      }
    };
    if (actions && bar) {
      releaseActionObservers?.();
      const resizeObserver = new ResizeObserver(syncActionOverflow);
      const mutationObserver = new MutationObserver(syncActionOverflow);
      resizeObserver.observe(bar);
      resizeObserver.observe(actions);
      const playerSlot = bar.querySelector<HTMLElement>("[data-app-bar-player]");
      if (playerSlot) resizeObserver.observe(playerSlot);
      mutationObserver.observe(bar, { childList: true, subtree: true });
      actions.addEventListener("scroll", syncActionOverflow, { passive: true });
      releaseActionObservers = () => {
        resizeObserver.disconnect();
        mutationObserver.disconnect();
        actions.removeEventListener("scroll", syncActionOverflow);
      };
      syncActionOverflow();
    }
  };

  initializeShell();
  syncEntityNavigation();
  document.addEventListener("astro:page-load", syncEntityNavigation);
  document.addEventListener("astro:page-load", initializeShell);
  persistentQuery.addEventListener("change", () => setModal(false));
  document.addEventListener("astro:before-swap", () => {
    setModal(false);
    releaseActionObservers?.();
    releaseActionObservers = undefined;
  });
</script>
