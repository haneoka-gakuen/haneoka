---
import Base from "../layouts/Base.astro";import AppShell from "./AppShell.astro";import type{Locale}from"../i18n/locales";import{t}from"../i18n/messages";import{resourcePath}from"../lib/resource-route";import type{ReleaseServer}from"../lib/release-server";import"../lit/help-workspace";import "../styles/catalog.css";import "../styles/help.css";const{locale,server}=Astro.props as{locale:Locale;server?:ReleaseServer};const title=t(locale,"navigation.help","Help");
---
<Base locale={locale} route="/catalog/help" canonicalRoute={server ? resourcePath({ server, locale, kind: "help" }) : undefined} title={title} titleKey="navigation.help"><AppShell locale={locale} route="/catalog/help" title={title} titleKey="navigation.help" server={server}><help-workspace locale={locale}></help-workspace></AppShell></Base><script>import "../lit/help-workspace";</script>
