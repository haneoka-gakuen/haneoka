---
import Icon from "../Icon.astro";
import I18nText from "../I18nText.astro";
import { CATALOG_HUB, NAV_SECTIONS } from "../../config/navigation";
import { localePath, type Locale } from "../../i18n/locales";
import { resourceCollectionHref } from "../../lib/resource-route";
import type { ReleaseServer } from "../../lib/release-server";
import { fetchStaticCatalog } from "../../lib/static-catalog-source";
const { locale, server = "intl", embedded = false } = Astro.props as { locale: Locale; server?: ReleaseServer; embedded?: boolean };
const summary = await fetchStaticCatalog("catalog/summary", server) as { resources?: Record<string, { count?: number }> };
const counts = summary.resources || {};
const resources = new Map(CATALOG_HUB.map((item) => [item.route, item.resource]));
// The catalogue destination's own sections; stories, tools, games and the community have their own destinations.
const sections = NAV_SECTIONS.filter((section) => section.id === "library");
---
<div class:list={["page", "catalog-hub", "stack", "stack--tight", { "page--embedded": embedded }]}>
  {sections.map((section) => (
    <section class="catalog-hub__section stack stack--tight" aria-labelledby={`catalog-hub-${section.id}`}>
      <h2 class="catalog-hub__headline" id={`catalog-hub-${section.id}`}><I18nText keyName={section.label} fallback={section.id} locale={locale} /></h2>
      <ul class="catalog-hub__grid" role="list">
        {section.items.map((item) => (
          <li>
            <a class="hub-link state-layer" href={resourceCollectionHref(item.route, server, locale) ?? `${localePath(item.route, locale)}${item.route.startsWith("/catalog") ? `?server=${server}` : ""}`} data-hub-route={item.route}>
              <span class="hub-link__icon"><Icon name={item.icon} size={22} /></span>
              <I18nText keyName={item.label} fallback={item.label} locale={locale} />
              <span class="hub-link__count tabular" data-count-resource={resources.get(item.route)} data-count-server={server}>{typeof counts[resources.get(item.route) || ""]?.count === "number" ? counts[resources.get(item.route) || ""]!.count!.toLocaleString(locale) : ""}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>
<script>
  import { catalogUrl, fetchJson, type JsonRecord } from "../../lit/shared/catalog";
  import { readReleaseServer } from "../../lib/release-server";
  import { resourceCollectionHref } from "../../lib/resource-route";
  import { localeFromPath, localePath } from "../../i18n/locales";
  const fillCounts = async () => {
    const server = readReleaseServer();
    const locale = localeFromPath(location.pathname) || "en";
    for (const link of document.querySelectorAll<HTMLAnchorElement>("[data-hub-route]")) {
      const route = link.dataset.hubRoute || "/catalog";
      link.href = resourceCollectionHref(route, server, locale) ?? `${localePath(route, locale)}${route.startsWith("/catalog") ? `?server=${server}` : ""}`;
    }
    const nodes = [...document.querySelectorAll<HTMLElement>("[data-count-resource]")].filter(node => node.dataset.countServer !== server);
    if (!nodes.length) return;
    try {
      const summary = await fetchJson<JsonRecord>(catalogUrl("catalog/summary"));
      const resources = (summary.resources || {}) as Record<string, { count?: number }>;
      const locale = document.documentElement.lang || "ja";
      nodes.forEach((node) => {
        const count = resources[node.dataset.countResource || ""]?.count;
        if (typeof count === "number") {
          node.textContent = count.toLocaleString(locale);
          node.dataset.countServer = server;
        }
      });
    } catch {
      // Counts are supplementary; the links work without them.
    }
  };
  void fillCounts();
  document.addEventListener("astro:page-load", () => void fillCounts());
</script>
<style is:global>
  @layer pages {
    .catalog-hub__headline {
      margin: 12px 0 0;
      padding-inline: 4px;
      color: var(--md-sys-color-on-surface-variant);
      font: var(--md-sys-typescale-title-small-weight) var(--md-sys-typescale-title-small-size) /
        var(--md-sys-typescale-title-small-line-height) var(--app-font);
    }
    .catalog-hub__grid {
      display: grid;
      align-content: start;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
      gap: 8px;
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .catalog-hub .hub-link > span:nth-child(2) {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    @media (max-width: 599px) {
      .catalog-hub__grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }
  }
</style>
