---
import type { Locale } from "../../i18n/locales";
import { LOCALES } from "../../i18n/locales";
const { locale, labels } = Astro.props as { locale: Locale; labels: string };
const intro = {
  ja: {
    heading: "BanG Dream! Our Notes 資料アーカイブ",
    body: "haneoka は、BanG Dream! Our Notes の楽曲、メンバー、カード、キャラクター、ストーリーやイベントの資料を整理して閲覧できる、コミュニティ運営の非公式プロジェクトです。",
    navigation: "資料を探す",
    catalog: "カタログ",
    songs: "楽曲",
    characters: "キャラクター",
  },
  en: {
    heading: "BanG Dream! Our Notes archive",
    body: "Haneoka is a community-maintained, unofficial project for browsing BanG Dream! Our Notes reference data, including songs, members, cards, characters, stories, and events.",
    navigation: "Browse the archive",
    catalog: "Catalog",
    songs: "Songs",
    characters: "Characters",
  },
  "zh-TW": {
    heading: "BanG Dream! Our Notes 資料典藏",
    body: "haneoka 是由社群維護的非官方專案，整理並提供 BanG Dream! Our Notes 的樂曲、團員、卡片、角色、故事與活動資料。",
    navigation: "瀏覽資料典藏",
    catalog: "圖鑑",
    songs: "樂曲",
    characters: "角色",
  },
  "zh-CN": {
    heading: "BanG Dream! Our Notes 资料库",
    body: "haneoka 是由社区维护的非官方项目，整理并提供 BanG Dream! Our Notes 的歌曲、成员、卡牌、角色、故事和活动资料。",
    navigation: "浏览资料库",
    catalog: "图鉴",
    songs: "歌曲",
    characters: "角色",
  },
  ko: {
    heading: "BanG Dream! Our Notes 자료 아카이브",
    body: "haneoka는 BanG Dream! Our Notes의 곡, 멤버, 카드, 캐릭터, 스토리와 이벤트 자료를 정리해 제공하는 커뮤니티 운영 비공식 프로젝트입니다.",
    navigation: "자료 둘러보기",
    catalog: "카탈로그",
    songs: "곡",
    characters: "캐릭터",
  },
} satisfies Record<
  Locale,
  { heading: string; body: string; navigation: string; catalog: string; songs: string; characters: string }
>;
const values = (key: keyof (typeof intro)["ja"]) =>
  JSON.stringify(Object.fromEntries(LOCALES.map((target) => [target, intro[target][key]])));
const copy = intro[locale];
---

<section class="home-seo-intro" aria-labelledby="home-seo-title">
  <h2 id="home-seo-title" data-i18n-values={values("heading")}>
    {copy.heading}
  </h2>
  <p data-i18n-values={values("body")}>{copy.body}</p>
  <nav
    aria-label={copy.navigation}
    data-i18n-aria-label-values={JSON.stringify(
      Object.fromEntries(LOCALES.map((target) => [target, intro[target].navigation])),
    )}
  >
    <a href="/catalog/" data-i18n-values={values("catalog")}>
      {copy.catalog}
    </a>
    <a href="/catalog/songs/" data-i18n-values={values("songs")}>
      {copy.songs}
    </a>
    <a href="/catalog/characters/" data-i18n-values={values("characters")}>
      {copy.characters}
    </a>
  </nav>
</section>
<home-dashboard locale={locale} labels={labels}></home-dashboard>
<script>
  import "../../lit/home-dashboard";
</script>
<style is:global>
  @import "../../styles/home.css";
</style>
<style>
  .home-seo-intro {
    width: min(100%, var(--content-max));
    margin: 0 auto;
    padding: 20px var(--md-comp-page-inline-space);
    color: var(--md-sys-color-on-surface);
  }
  .home-seo-intro h2 {
    margin: 0;
    font: 500 1.25rem/1.4 var(--app-font);
  }
  .home-seo-intro p {
    max-width: 78ch;
    margin: 8px 0 12px;
    color: var(--md-sys-color-on-surface-variant);
    font: 400 0.95rem/1.65 var(--app-font);
  }
  .home-seo-intro nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
  }
  .home-seo-intro a {
    color: var(--md-sys-color-primary);
    font: 500 0.9rem/1.5 var(--app-font);
    text-underline-offset: 0.18em;
  }
</style>
