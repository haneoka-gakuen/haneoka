---
import Icon from "../Icon.astro";
import { group } from "../../i18n/messages";
import type { Locale } from "../../i18n/locales";
import { SPONSOR_PLATFORMS, SPONSOR_TIERS, sponsorCardImage } from "../../config/sponsor";
import { sponsorList } from "../../server/sponsors";

interface SponsorCopy {
  heroTitle: string;
  body: string[];
  afdian: string;
  patreon: string;
  kofi: string;
  wallTitle: string;
  wallUpdated: string;
  tierEmpty: string;
  pastTitle: string;
}

const { locale } = Astro.props as { locale: Locale };
const copy = group<SponsorCopy>(locale, "legal.sponsor");
const list = await sponsorList();
const updated = new Intl.DateTimeFormat(locale, { dateStyle: "medium" }).format(new Date(list.updatedAt));
const tiers = SPONSOR_TIERS.map((tier) => ({ ...tier, sponsors: list.active.filter((row) => row.tier === tier.id) }));
const initial = (name: string) => [...name][0]?.toUpperCase() ?? "";
---

<article class="about backing" aria-labelledby="backing-heading">
  <header class="backing-hero">
    <div class="backing-hero__copy">
      <h2 id="backing-heading" class="about-display about-display--small">{copy.heroTitle}</h2>
      {copy.body.map((paragraph, index) => <p class={index === 0 ? "about-lede" : "about-body"}>{paragraph}</p>)}
    </div>
    <div class="backing-links">
      {SPONSOR_PLATFORMS.map((platform) => (
        <a class={`backing-link backing-link--${platform.id}`} href={platform.url} target="_blank" rel="noopener">
          {platform.id === "afdian" && <Icon name="electric_bolt" size={24} filled />}
          {platform.id === "patreon" && (
            <svg class="material-icon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><circle cx="14.5" cy="9.5" r="7" fill="currentColor" /><rect x="3" y="2.5" width="3.5" height="19" rx="0.6" fill="currentColor" /></svg>
          )}
          {platform.id === "kofi" && <Icon name="local_cafe" size={24} filled />}
          <span>{copy[platform.id]}</span>
          <Icon name="open_in_new" size={20} />
        </a>
      ))}
    </div>
  </header>

  <section class="backing-section" aria-labelledby="backing-wall">
    <div class="backing-wall__head">
      <h3 id="backing-wall" class="about-headline">{copy.wallTitle}</h3>
      <span class="backing-wall__updated">{copy.wallUpdated.replace("{date}", updated)}</span>
    </div>
    {tiers.map((tier) => (
      <section class={`backing-tier backing-tier--${tier.id}`} aria-labelledby={`backing-tier-${tier.id}`}>
        <h4 id={`backing-tier-${tier.id}`} class="backing-tier__title">
          <img src={sponsorCardImage(tier.card)} alt="" width="300" height="140" loading="lazy" decoding="async" />
          <span class="backing-tier__label"><span>{tier.title}</span><span class="backing-tier__count">{tier.sponsors.length}</span></span>
        </h4>
          {tier.sponsors.length ? (
            <ul class="backing-names">
              {tier.sponsors.map((sponsor) => (
                <li class="backing-name">
                  {sponsor.avatar ? (
                    <img src={sponsor.avatar} alt="" width="40" height="40" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
                  ) : (
                    <span class="backing-name__initial" aria-hidden="true">{initial(sponsor.name)}</span>
                  )}
                  <span class="backing-name__text">{sponsor.name}</span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="backing-tier__empty">{copy.tierEmpty}</p>
          )}
      </section>
    ))}
    {list.past.length > 0 && (
      <section class="backing-past" aria-labelledby="backing-past">
        <h4 id="backing-past" class="backing-tier__title"><span class="backing-tier__label"><span>{copy.pastTitle}</span><span class="backing-tier__count">{list.past.length}</span></span></h4>
        <ul>{list.past.map((sponsor) => <li>{sponsor.name}</li>)}</ul>
      </section>
    )}
  </section>
</article>
