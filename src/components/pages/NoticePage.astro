---
import Icon from "../Icon.astro";
import { LOCALES, type Locale } from "../../i18n/locales";
import { t } from "../../i18n/messages";
const { locale, title, route, titleKey } = Astro.props as {
  locale: Locale;
  title: string;
  route: string;
  titleKey?: string;
};
const isAccount = route.startsWith("/account");
const isCommunity = route.startsWith("/community");
const icon = isAccount ? "account_circle" : isCommunity ? "forum" : "construction";
const messageKey = isAccount
  ? "account.page.signInDescription"
  : isCommunity
    ? "community.page.description"
    : "navigation.construction";
const translated = (key: string, fallback = key) =>
  JSON.stringify(Object.fromEntries(LOCALES.map((lang) => [lang, t(lang, key, fallback)])));
const message = isAccount
  ? t(locale, "account.page.signInDescription", "Sign in to access your account.")
  : isCommunity
    ? t(locale, "community.page.description", "Community data is loaded on demand.")
    : t(locale, "navigation.construction", "This catalog is ready for its next data release.");
---

<section class="page page--compact">
  <div class:list={["notice", { "notice--construction": !isAccount && !isCommunity }]}>
    {!isAccount && !isCommunity && (
      <div class="notice__art media-loading">
        <img
          src="/images/maintenance-characters.png"
          alt=""
          decoding="async"
          onload="this.classList.add('is-loaded')"
        />
      </div>
    )}
    <span class="notice__icon">
      <Icon name={icon} size={36} />
    </span>
    <h2 data-i18n-values={translated(titleKey || "catalog.construction.title", title)}>{title}</h2>
    <p data-i18n-values={translated(messageKey, message)}>{message}</p>
    {isAccount && (
      <a
        class="button"
        href="/api/auth/sign-in/social?provider=discord"
        data-i18n-values={translated("account.page.signIn", "Sign in")}
      >
        {t(locale, "account.page.signIn", "Sign in")}
      </a>
    )}
  </div>
</section>
