---
import PlatformLogo from "../PlatformLogo.astro";
import Icon from "../Icon.astro";
import I18nText from "../I18nText.astro";
import type { Locale } from "../../i18n/locales";
import { t } from "../../i18n/messages";
import { appRelease } from "../../server/app-release";
import "../../styles/download.css";
const { locale } = Astro.props as { locale: Locale };
const release = await appRelease();
const text = (key: string) => t(locale, `download.${key}`);
const platforms = [
  { id: "android", name: "Android", system: "Android 8+", groups: ["arm64-v8a", "x86_64", "universal"], preferred: "-android-arm64-v8a.apk" },
  { id: "ios", name: "iOS / iPadOS", system: "iOS 15+ / ARM64", groups: ["arm64"], preferred: "-ios-unsigned.ipa" },
  { id: "windows", name: "Windows", system: "Windows 10+", groups: ["x64", "arm64"], preferred: "-windows-x64-setup.exe" },
  { id: "macos", name: "macOS", system: "macOS 12+", groups: ["arm64", "x64"], preferred: "-macos-arm64.dmg" },
  { id: "linux", name: "Linux", system: "Linux / WebKitGTK 4.1", groups: ["x64", "arm64"], preferred: "-linux-x64.flatpak" },
];
const groupLabel = (platform: string, arch: string) => arch === "universal" ? text("universal") : platform === "macos" ? (arch === "arm64" ? "Apple Silicon / ARM64" : "Intel / x64") : ({ "arm64-v8a": "ARM64 / arm64-v8a", "armeabi-v7a": "ARM32 / armeabi-v7a", "x86_64": "x86-64", "arm64": "ARM64", "x64": "x64" }[arch] ?? arch);
const packages = release.assets.filter((a) => /\.(apk|aab|ipa|tipa|exe|msi|msix|zip|dmg|pkg|AppImage|deb|rpm|flatpak|snap|zst|gz)$/.test(a.name));
const linuxFormats = [".AppImage", ".flatpak", ".snap", ".deb", ".rpm", ".pkg.tar.zst", ".tar.gz"];
const assetsFor = (platform: string, arch: string) => {
  const assets = packages.filter((a) => platform === "ios" ? a.name.includes("-ios-") : arch === "universal" ? /-android\.(apk|aab)$/.test(a.name) : a.name.includes(`-${platform}-${arch}`));
  return platform === "linux" ? assets.sort((a, b) => linuxFormats.findIndex((suffix) => a.name.endsWith(suffix)) - linuxFormats.findIndex((suffix) => b.name.endsWith(suffix))) : assets;
};
const format = (name: string) => name.endsWith(".pkg.tar.zst") ? "Arch" : name.endsWith(".tar.gz") ? "tar.gz" : name.endsWith(".tipa") ? "TrollStore / TIPA" : name.endsWith(".ipa") ? "IPA" : name.endsWith(".exe") ? `EXE / ${text("installer")}` : name.endsWith(".zip") ? `ZIP / ${text("portable")}` : name.endsWith(".aab") ? `AAB / ${text("bundle")}` : name.split(".").pop()!;
const size = (bytes: number) => `${(bytes / 1024 / 1024).toFixed(1)} MB`;
const extras = release.assets.filter((a) => !packages.includes(a) && a.name !== "release-version.json");
---
<article class="downloads" aria-labelledby="download-heading">
  <header class="download-hero">
    <div class="download-hero__copy">
      <span class="download-release"><span class="download-dot"></span> HANEOKA APP <span class="download-release__version">{release.tag_name}</span></span>
      <h2 id="download-heading"><I18nText keyName="download.hero" locale={locale} /></h2>
      <p><I18nText keyName="download.intro" locale={locale} /></p>
      <a class="download-main" href="#platforms"><Icon name="download" size={26} /><I18nText keyName="download.all" locale={locale} /><Icon name="arrow_downward" size={22} /></a>
      <div class="download-hero__links">
        <a href={release.html_url} target="_blank" rel="noreferrer"><I18nText keyName="download.release" locale={locale} /><Icon name="arrow_outward" size={16} /></a>
        <a href="https://github.com/haneoka-gakuen/haneoka-app" target="_blank" rel="noreferrer"><I18nText keyName="download.source" locale={locale} /><Icon name="code" size={18} /></a>
      </div>
    </div>
    <div class="download-art" aria-hidden="true">
      <span class="download-art__orbit"></span>
      <span class="download-art__flower shape-cookie-12"><Icon name="download" size={100} /></span>
      <span class="download-art__badge"><Icon name="favorite" size={24} /> Haneoka</span>
      <span class="download-art__device download-art__device--one"><Icon name="laptop_mac" size={44} /></span>
      <span class="download-art__device download-art__device--two"><Icon name="phone_iphone" size={36} /></span>
      <span class="download-art__spark">✦</span>
    </div>
  </header>
  <nav class="download-platform-nav" aria-label={text("all")}>
    {[platforms.slice(0, 2), platforms.slice(2)].map((row) => <div class="download-platform-nav__row">{row.map((platform) => <a href={`#download-${platform.id}`}><PlatformLogo platform={platform.id} />{platform.name}<Icon name="arrow_downward" size={16} /></a>)}</div>)}
  </nav>
  <section class="download-save" aria-labelledby="download-save-heading">
    <span class="download-platform-icon"><Icon name="save" size={32} /></span>
    <div><h2 id="download-save-heading"><I18nText keyName="download.saveTitle" locale={locale} /></h2><dl class="spec-list spec-list--split download-save__methods">{[["Android", "download.saveAndroid"], ["download.saveDesktopLabel", "download.saveDesktop"], ["iOS", "download.saveIos"]].map(([label, value]) => <div><dt>{label.startsWith("download.") ? <I18nText keyName={label} locale={locale} /> : label}</dt><dd><I18nText keyName={value} locale={locale} /></dd></div>)}</dl><a href="https://github.com/haneoka-gakuen/haneoka-app#getting-the-save" target="_blank" rel="noreferrer"><I18nText keyName="download.saveGuide" locale={locale} /><Icon name="arrow_outward" size={18} /></a></div>
  </section>
  <section id="platforms" class="download-platforms" aria-labelledby="download-platforms-heading">
    <header class="download-section-heading"><div><h2 id="download-platforms-heading"><I18nText keyName="download.packages" locale={locale} /></h2></div></header>
    <div class="download-grid">
      {platforms.map((platform) => {
        const preferred = packages.find((a) => a.name.endsWith(platform.preferred));
        return <section class={`download-card download-card--${platform.id}`} id={`download-${platform.id}`} aria-labelledby={`title-${platform.id}`}>
          <header class="download-card__header"><span class="download-platform-icon"><PlatformLogo platform={platform.id} /></span><div><h3 id={`title-${platform.id}`}>{platform.name}</h3><p>{platform.system}</p></div></header>
          {preferred && <a class="download-primary" href={preferred.browser_download_url}><Icon name="download" size={24} /><span><strong><I18nText keyName="download.download" locale={locale} /> {platform.name}</strong><small>{platform.id === "android" ? "ARM64" : platform.id === "macos" ? "Apple Silicon" : platform.id === "ios" ? "ARM64" : "x64"} / {format(preferred.name)} / {size(preferred.size)}</small></span><Icon name="arrow_downward" size={22} /></a>}
          {platform.id === "windows" && <a class="chip" href="https://learn.microsoft.com/windows/arm/apps-on-arm-x86-emulation" target="_blank" rel="noreferrer"><I18nText keyName="download.windowsArmPackage" locale={locale} /></a>}
          <div class="download-architectures">{platform.groups.map((arch) => {
            const assets = assetsFor(platform.id, arch);
            return assets.length > 0 && <div class="download-architecture"><h4>{groupLabel(platform.id, arch)}</h4><div class="download-package-buttons">{assets.map((asset) => <a class="download-package" href={asset.browser_download_url} title={`${asset.name} / ${size(asset.size)}`}><Icon name="download" size={18} /><span>{format(asset.name)}<small>{size(asset.size)}</small></span></a>)}</div></div>;
          })}</div>
          <p class="download-note"><Icon name="info" size={18} /><I18nText keyName={`download.${platform.id}Note`} locale={locale} /></p>
        </section>;
      })}
    </div>
  </section>
  <section class="download-extras" aria-labelledby="download-extras-heading"><header><h2 id="download-extras-heading"><I18nText keyName="download.extras" locale={locale} /></h2></header><div class="download-extra-links">{extras.map((asset) => <a href={asset.browser_download_url}><Icon name={asset.name === "SHA256SUMS" ? "verified_user" : "download"} size={22} /><span>{asset.name === "SHA256SUMS" ? text("checksums") : asset.name}</span><Icon name="arrow_downward" size={18} /></a>)}</div></section>
</article>
