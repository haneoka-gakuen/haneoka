---
import Icon from "../Icon.astro";
import ContactEmail from "../ContactEmail.astro";
import I18nText from "../I18nText.astro";
import { group } from "../../i18n/messages";
import type { Locale } from "../../i18n/locales";

interface JoinCopy {
  eyebrow: string;
  title: string;
  heroTitle: string;
  description: string;
  feedbackTitle: string;
  feedbackBody: string;
  githubTitle: string;
  githubBody: string;
  githubIssues: string;
  githubPulls: string;
  communityTitle: string;
  communityBody: string;
  forumFeedback: string;
  forumBugs: string;
  forumFeatures: string;
}

const { locale } = Astro.props as { locale: Locale };
const copy = group<JoinCopy>(locale, "legal.join");
const repo = "https://github.com/haneoka-gakuen/haneoka";
const forum = (slug: string) => `/${locale}/community/forums/${slug}/`;
const k = (key: keyof JoinCopy) => `legal.join.${key}`;
---

<article class="about join" aria-labelledby="join-heading">
  <header class="join-hero">
    <span class="join-hero__mark shape-cookie-9" aria-hidden="true"><Icon name="handshake" size={48} /></span>
    <div class="join-hero__copy">
      <p class="about-eyebrow"><I18nText keyName={k("eyebrow")} fallback={copy.eyebrow} locale={locale} /></p>
      <h2 id="join-heading" class="about-display about-display--small">
        <I18nText keyName={k("heroTitle")} fallback={copy.heroTitle} locale={locale} />
      </h2>
      <p class="about-lede"><I18nText keyName={k("description")} fallback={copy.description} locale={locale} /></p>
    </div>
  </header>

  <section class="join-section" aria-labelledby="join-feedback">
    <div class="join-section__head">
      <h3 id="join-feedback" class="about-headline"><I18nText keyName={k("feedbackTitle")} fallback={copy.feedbackTitle} locale={locale} /></h3>
      <p class="about-body"><I18nText keyName={k("feedbackBody")} fallback={copy.feedbackBody} locale={locale} /></p>
      <div class="cluster"><ContactEmail class="button button--text" /></div>
    </div>
    <div class="join-grid">
      <div class="join-card">
        <span class="join-card__icon shape-sunny" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="28" height="28"><path fill="currentColor" d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57v-2.23c-3.34.73-4.04-1.42-4.04-1.42-.55-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22v3.29c0 .31.21.69.82.57A12 12 0 0 0 12 .3"/></svg>
        </span>
        <h4 class="join-card__title"><I18nText keyName={k("githubTitle")} fallback={copy.githubTitle} locale={locale} /></h4>
        <p class="join-card__body"><I18nText keyName={k("githubBody")} fallback={copy.githubBody} locale={locale} /></p>
        <div class="join-card__actions">
          <a class="button" href={`${repo}/issues/new/choose`} target="_blank" rel="noopener">
            <Icon name="error" size={20} /><I18nText keyName={k("githubIssues")} fallback={copy.githubIssues} locale={locale} />
          </a>
          <a class="button button--tonal" href={`${repo}/pulls`} target="_blank" rel="noopener">
            <Icon name="code" size={20} /><I18nText keyName={k("githubPulls")} fallback={copy.githubPulls} locale={locale} />
          </a>
        </div>
      </div>
      <div class="join-card">
        <span class="join-card__icon shape-clover-4" aria-hidden="true"><Icon name="forum" size={28} /></span>
        <h4 class="join-card__title"><I18nText keyName={k("communityTitle")} fallback={copy.communityTitle} locale={locale} /></h4>
        <p class="join-card__body"><I18nText keyName={k("communityBody")} fallback={copy.communityBody} locale={locale} /></p>
        <div class="join-card__chips">
          <a class="join-chip" href={forum("feedback")}><Icon name="chat" size={18} /><I18nText keyName={k("forumFeedback")} fallback={copy.forumFeedback} locale={locale} /></a>
          <a class="join-chip" href={forum("bug-report")}><Icon name="error" size={18} /><I18nText keyName={k("forumBugs")} fallback={copy.forumBugs} locale={locale} /></a>
          <a class="join-chip" href={forum("new-feature-request")}><Icon name="lightbulb" size={18} /><I18nText keyName={k("forumFeatures")} fallback={copy.forumFeatures} locale={locale} /></a>
        </div>
      </div>
    </div>
  </section>

</article>
