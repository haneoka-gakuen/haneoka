---
import Icon from "../Icon.astro";
import I18nText from "../I18nText.astro";
import { group } from "../../i18n/messages";
import type { Locale } from "../../i18n/locales";

interface JoinCopy {
  eyebrow: string;
  title: string;
  heroTitle: string;
  description: string;
  feedbackTitle: string;
  feedbackBody: string;
  githubTitle: string;
  githubBody: string;
  githubIssues: string;
  githubPulls: string;
  communityTitle: string;
  communityBody: string;
  forumFeedback: string;
  forumBugs: string;
  forumFeatures: string;
  connectTitle: string;
  connectBody: string;
  discordTitle: string;
  discordBody: string;
  discordAction: string;
  qqTitle: string;
  qqBody: string;
  qqLabel: string;
  copy: string;
  copied: string;
  mention: string;
  partnerTitle: string;
  partnerBody: string;
}

const { locale } = Astro.props as { locale: Locale };
const copy = group<JoinCopy>(locale, "legal.join");
const repo = "https://github.com/haneoka-gakuen/haneoka";
const forum = (slug: string) => `/${locale}/community/forums/${slug}/`;
const DISCORD = "https://discord.gg/GKU3bwS9sN";
const QQ_GROUP = "754989697";
const k = (key: keyof JoinCopy) => `legal.join.${key}`;
---

<article class="about join" aria-labelledby="join-heading">
  <header class="join-hero">
    <span class="join-hero__mark shape-cookie-9" aria-hidden="true"><Icon name="handshake" size={48} /></span>
    <div class="join-hero__copy">
      <p class="about-eyebrow"><I18nText keyName={k("eyebrow")} fallback={copy.eyebrow} locale={locale} /></p>
      <h2 id="join-heading" class="about-display about-display--small">
        <I18nText keyName={k("heroTitle")} fallback={copy.heroTitle} locale={locale} />
      </h2>
      <p class="about-lede"><I18nText keyName={k("description")} fallback={copy.description} locale={locale} /></p>
    </div>
  </header>

  <section class="join-section" aria-labelledby="join-feedback">
    <div class="join-section__head">
      <h3 id="join-feedback" class="about-headline"><I18nText keyName={k("feedbackTitle")} fallback={copy.feedbackTitle} locale={locale} /></h3>
      <p class="about-body"><I18nText keyName={k("feedbackBody")} fallback={copy.feedbackBody} locale={locale} /></p>
    </div>
    <div class="join-grid">
      <div class="join-card">
        <span class="join-card__icon shape-sunny" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="28" height="28"><path fill="currentColor" d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57v-2.23c-3.34.73-4.04-1.42-4.04-1.42-.55-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22v3.29c0 .31.21.69.82.57A12 12 0 0 0 12 .3"/></svg>
        </span>
        <h4 class="join-card__title"><I18nText keyName={k("githubTitle")} fallback={copy.githubTitle} locale={locale} /></h4>
        <p class="join-card__body"><I18nText keyName={k("githubBody")} fallback={copy.githubBody} locale={locale} /></p>
        <div class="join-card__actions">
          <a class="button" href={`${repo}/issues/new/choose`} target="_blank" rel="noopener">
            <Icon name="error" size={20} /><I18nText keyName={k("githubIssues")} fallback={copy.githubIssues} locale={locale} />
          </a>
          <a class="button button--tonal" href={`${repo}/pulls`} target="_blank" rel="noopener">
            <Icon name="code" size={20} /><I18nText keyName={k("githubPulls")} fallback={copy.githubPulls} locale={locale} />
          </a>
        </div>
      </div>
      <div class="join-card">
        <span class="join-card__icon shape-clover-4" aria-hidden="true"><Icon name="forum" size={28} /></span>
        <h4 class="join-card__title"><I18nText keyName={k("communityTitle")} fallback={copy.communityTitle} locale={locale} /></h4>
        <p class="join-card__body"><I18nText keyName={k("communityBody")} fallback={copy.communityBody} locale={locale} /></p>
        <div class="join-card__chips">
          <a class="join-chip" href={forum("feedback")}><Icon name="chat" size={18} /><I18nText keyName={k("forumFeedback")} fallback={copy.forumFeedback} locale={locale} /></a>
          <a class="join-chip" href={forum("bug-report")}><Icon name="error" size={18} /><I18nText keyName={k("forumBugs")} fallback={copy.forumBugs} locale={locale} /></a>
          <a class="join-chip" href={forum("new-feature-request")}><Icon name="lightbulb" size={18} /><I18nText keyName={k("forumFeatures")} fallback={copy.forumFeatures} locale={locale} /></a>
        </div>
      </div>
    </div>
  </section>

  <section class="join-section" aria-labelledby="join-connect">
    <div class="join-section__head">
      <h3 id="join-connect" class="about-headline"><I18nText keyName={k("connectTitle")} fallback={copy.connectTitle} locale={locale} /></h3>
      <p class="about-body"><I18nText keyName={k("connectBody")} fallback={copy.connectBody} locale={locale} /></p>
    </div>
    <div class="join-grid">
      <div class="join-card join-card--accent">
        <span class="join-card__icon shape-soft-burst" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="28" height="28"><path fill="currentColor" d="M20.32 4.37a19.8 19.8 0 0 0-4.89-1.52.07.07 0 0 0-.08.04c-.21.38-.44.87-.61 1.25a18.27 18.27 0 0 0-5.49 0 12.64 12.64 0 0 0-.62-1.25.08.08 0 0 0-.08-.04 19.74 19.74 0 0 0-4.88 1.52.07.07 0 0 0-.03.03C.53 9.05-.32 13.58.1 18.06a.08.08 0 0 0 .03.06 19.9 19.9 0 0 0 5.99 3.03.08.08 0 0 0 .08-.03c.46-.63.87-1.3 1.23-1.99a.08.08 0 0 0-.04-.11 13.1 13.1 0 0 1-1.87-.9.08.08 0 0 1-.01-.13l.37-.29a.07.07 0 0 1 .08-.01c3.93 1.8 8.18 1.8 12.06 0a.07.07 0 0 1 .08.01l.37.29a.08.08 0 0 1-.01.13c-.6.35-1.22.65-1.87.9a.08.08 0 0 0-.04.11c.36.7.78 1.36 1.23 1.99a.08.08 0 0 0 .08.03 19.84 19.84 0 0 0 6-3.03.08.08 0 0 0 .03-.06c.5-5.18-.84-9.67-3.55-13.66a.06.06 0 0 0-.03-.03zM8.02 15.33c-1.18 0-2.16-1.08-2.16-2.42 0-1.33.96-2.42 2.16-2.42 1.21 0 2.18 1.1 2.16 2.42 0 1.34-.96 2.42-2.16 2.42zm7.97 0c-1.18 0-2.15-1.08-2.15-2.42 0-1.33.95-2.42 2.15-2.42 1.22 0 2.18 1.1 2.16 2.42 0 1.34-.94 2.42-2.16 2.42z"/></svg>
        </span>
        <h4 class="join-card__title"><I18nText keyName={k("discordTitle")} fallback={copy.discordTitle} locale={locale} /></h4>
        <p class="join-card__body"><I18nText keyName={k("discordBody")} fallback={copy.discordBody} locale={locale} /></p>
        <p class="join-card__note"><Icon name="info" size={18} /><I18nText keyName={k("mention")} fallback={copy.mention} locale={locale} /></p>
        <div class="join-card__actions">
          <a class="button" href={DISCORD} target="_blank" rel="noopener">
            <I18nText keyName={k("discordAction")} fallback={copy.discordAction} locale={locale} /><Icon name="open_in_new" size={20} />
          </a>
        </div>
      </div>
      <div class="join-card join-card--accent">
        <span class="join-card__icon shape-flower" aria-hidden="true"><Icon name="groups" size={28} /></span>
        <h4 class="join-card__title"><I18nText keyName={k("qqTitle")} fallback={copy.qqTitle} locale={locale} /></h4>
        <p class="join-card__body"><I18nText keyName={k("qqBody")} fallback={copy.qqBody} locale={locale} /></p>
        <p class="join-card__note"><Icon name="info" size={18} /><I18nText keyName={k("mention")} fallback={copy.mention} locale={locale} /></p>
        <div class="join-qq">
          <span class="join-qq__label"><I18nText keyName={k("qqLabel")} fallback={copy.qqLabel} locale={locale} /></span>
          <span class="join-qq__number tabular">{QQ_GROUP}</span>
          <button class="button button--tonal join-copy" type="button" data-copy={QQ_GROUP} data-copied={copy.copied}>
            <Icon name="content_copy" size={20} /><span><I18nText keyName={k("copy")} fallback={copy.copy} locale={locale} /></span>
          </button>
        </div>
      </div>
    </div>
  </section>

  <aside class="join-partner" aria-labelledby="join-partner">
    <Icon name="handshake" size={28} />
    <div>
      <h3 id="join-partner" class="join-partner__title"><I18nText keyName={k("partnerTitle")} fallback={copy.partnerTitle} locale={locale} /></h3>
      <p class="about-body"><I18nText keyName={k("partnerBody")} fallback={copy.partnerBody} locale={locale} /></p>
    </div>
  </aside>
</article>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>(".join-copy")) {
    button.addEventListener("click", async () => {
      const label = button.querySelector("span");
      const original = label?.textContent ?? "";
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? "");
        if (label) label.textContent = button.dataset.copied ?? original;
        setTimeout(() => {
          if (label) label.textContent = original;
        }, 1600);
      } catch {
        /* Clipboard unavailable: the number stays visible to copy by hand. */
      }
    });
  }
</script>
