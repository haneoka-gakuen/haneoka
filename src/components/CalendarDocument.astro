---
import Base from "../layouts/Base.astro";
import AppShell from "./AppShell.astro";
import { t, group } from "../i18n/messages";
import type { Locale } from "../i18n/locales";
import type { ReleaseServer } from "../lib/release-server";
import { loadCalendarData, renderCalendar } from "../server/calendar";
import { serializePageData } from "../lib/page-data";
import "../styles/calendar.css";

const { locale, server = "intl" } = Astro.props as { locale: Locale; server?: ReleaseServer };
const calendar = await loadCalendarData(server, locale);
const labels: Record<string, string> = { ...(group<Record<string, string>>(locale, "calendar") || {}), filter: t(locale, "filter", "Filter"), close: t(locale, "close", "Close"), reset: t(locale, "reset", "Reset") };
const title = labels.title || t(locale, "calendar.title", "Calendar");
const body = await renderCalendar(calendar, locale, labels);
const dataId = `calendar-data-${server}`;
---

<Base
  locale={locale}
  route="/calendar"
  canonicalRoute={`/${server}/${locale}/calendar/`}
  title={title}
  titleKey="calendar.title"
>
  <AppShell locale={locale} server={server} route="/calendar" title={title} titleKey="calendar.title">
    <calendar-page class="page" locale={locale} data-page-data={dataId} data-prerendered>
      <Fragment set:html={body} />
    </calendar-page>
    <script is:inline type="application/json" id={dataId} set:html={serializePageData({ calendar, labels })}></script>
  </AppShell>
</Base>
<script>
  import "../lit/calendar-page";
</script>
