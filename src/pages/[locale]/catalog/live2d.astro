---
import Live2DDocument from "../../../components/Live2DDocument.astro";
import { LOCALES, type Locale } from "../../../i18n/locales";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale }, props: { locale } }));
}
const { locale } = Astro.props as { locale: Locale };
---
<Live2DDocument locale={locale} />
