---
import AccountDocument from "../../components/AccountDocument.astro";
import { LOCALES, type Locale } from "../../i18n/locales";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale }, props: { locale } }));
}
const { locale } = Astro.props as { locale: Locale };
---
<AccountDocument locale={locale} />
