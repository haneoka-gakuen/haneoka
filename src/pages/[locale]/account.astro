---
import { staticBuildPaths } from "../../server/static-build";
import AccountDocument from "../../components/AccountDocument.astro";
import { LOCALES, type Locale } from "../../i18n/locales";

export function getStaticPaths() {
  return staticBuildPaths("src/pages/[locale]/account.astro", LOCALES.map((locale) => ({ params: { locale }, props: { locale } })));
}
const { locale } = Astro.props as { locale: Locale };
---
<AccountDocument locale={locale} />
