---
import Base from "../../layouts/Base.astro";
import AppShell from "../../components/AppShell.astro";
import TeamBuilderPage from "../../components/pages/TeamBuilderPage.astro";
import { LOCALES, type Locale } from "../../i18n/locales";
import { t } from "../../i18n/messages";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale }, props: { locale } }));
}
const { locale } = Astro.props as { locale: Locale };
const route = "/team-builder";
const title = t(locale, "tools.teamBuilder.title", "Team builder");
---

<Base locale={locale} route={route} title={title} titleKey="tools.teamBuilder.title">
  <AppShell locale={locale} route={route} title={title} titleKey="tools.teamBuilder.title">
    <TeamBuilderPage locale={locale} />
  </AppShell>
</Base>
