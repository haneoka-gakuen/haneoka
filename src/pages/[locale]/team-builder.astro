---
import { staticBuildPaths } from "../../server/static-build";
import Base from "../../layouts/Base.astro";
import AppShell from "../../components/AppShell.astro";
import TeamBuilderPage from "../../components/pages/TeamBuilderPage.astro";
import { LOCALES, type Locale } from "../../i18n/locales";
import { t } from "../../i18n/messages";
import { teamBuilderPageData } from "../../server/tool-page-data";
import { renderTeamBuilderPage } from "../../server/render-tools";

export function getStaticPaths() {
  return staticBuildPaths("src/pages/[locale]/team-builder.astro", LOCALES.map((locale) => ({ params: { locale }, props: { locale } })));
}
const { locale } = Astro.props as { locale: Locale };
const route = "/team-builder";
const title = t(locale, "tools.teamBuilder.title", "Team builder");
const page = await renderTeamBuilderPage(await teamBuilderPageData("intl"), locale);
---

<Base locale={locale} route={route} title={title} titleKey="tools.teamBuilder.title">
  <AppShell locale={locale} route={route} title={title} titleKey="tools.teamBuilder.title" appBar={page.appBar}>
    <TeamBuilderPage locale={locale} />
  </AppShell>
</Base>
