---
import { staticBuildPaths } from "../../../../../../server/static-build";
import Page from "../../../../../../components/entities/ProviderSongEntityPage.astro";
import { LOCALES, type Locale } from "../../../../../../i18n/locales";

export function getStaticPaths() {
  return staticBuildPaths("src/pages/[locale]/community/[namespace]/songs/[id]/chart.astro", LOCALES.flatMap(locale =>
    ["gbp", "sekai"].map(namespace => ({ params: { locale, namespace, id: "_" } })),
  ));
}
const provider = Astro.params.namespace === "gbp" ? "bestdori" : "sekai";
---
<Page locale={Astro.params.locale as Locale} provider={provider} chartPage />
