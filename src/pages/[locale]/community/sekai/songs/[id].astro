---
import { staticBuildPaths } from "../../../../../server/static-build";
import Page from "../../../../../components/entities/ProviderSongEntityPage.astro";
import { LOCALES, type Locale } from "../../../../../i18n/locales";

export function getStaticPaths() {
  return staticBuildPaths("src/pages/[locale]/community/sekai/songs/[id].astro", LOCALES.map(locale => ({ params: { locale, id: "_" } })));
}
---
<Page locale={Astro.params.locale as Locale} provider="sekai" />
