---
import { staticBuildPaths } from "../../../../../server/static-build";
import Base from "../../../../../layouts/Base.astro";
import AppShell from "../../../../../components/AppShell.astro";
import { catalogConfig } from "../../../../../config/catalog-labels";
import { LOCALES, type Locale } from "../../../../../i18n/locales";
import { t } from "../../../../../i18n/messages";
import "../../../../../lit/catalog-screen";
import "../../../../../styles/catalog.css";

export function getStaticPaths() {
  return staticBuildPaths("src/pages/[locale]/community/sekai/songs/detail.astro", LOCALES.map((locale) => ({ params: { locale }, props: { locale } })));
}
const { locale } = Astro.props as { locale: Locale };
const route = "/community/sekai/songs";
const title = t(locale, "community.page.sekai.title", "Project Sekai songs");
const config = catalogConfig({ resource: "songs", locale, origin: "sekai", entityContext: true });
const entity = { title, backHref: `/${locale}/community/sekai/songs/` };
---

<Base locale={locale} route={route} title={title} description={title} noindex>
  <AppShell locale={locale} route={route} title={title} entity={entity}>
    <catalog-screen config={config}></catalog-screen>
  </AppShell>
</Base>
<script>
  import "../../../../../lit/catalog-screen";
</script>
