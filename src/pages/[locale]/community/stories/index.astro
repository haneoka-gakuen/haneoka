---
import { staticBuildPaths } from "../../../../server/static-build";
import Page from "../../../../components/CommunityStoriesDocument.astro";
import { LOCALES, type Locale } from "../../../../i18n/locales";
export function getStaticPaths() {
  return staticBuildPaths("src/pages/[locale]/community/stories/index.astro", LOCALES.map(locale => ({ params: { locale } })));
}
const locale = Astro.params.locale as Locale;
---
<Page locale={locale} server="intl" />
