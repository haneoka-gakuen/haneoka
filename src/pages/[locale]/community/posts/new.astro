---
import CommunityRoute from "../../../../components/CommunityRoute.astro";
import { LOCALES, type Locale } from "../../../../i18n/locales";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale }, props: { locale } }));
}
const { locale } = Astro.props as { locale: Locale };
---
<CommunityRoute mode="feeds" route="/community/posts/new" titleKey="newPost" fallback="New post" locale={locale} />
