---
import { staticBuildPaths } from "../../../../server/static-build";
import CommunityRoute from "../../../../components/CommunityRoute.astro";
import { LOCALES, type Locale } from "../../../../i18n/locales";

export function getStaticPaths() {
  return staticBuildPaths("src/pages/[locale]/community/posts/new.astro", LOCALES.map((locale) => ({ params: { locale }, props: { locale } })));
}
const { locale } = Astro.props as { locale: Locale };
---
<CommunityRoute mode="feeds" route="/community/posts/new" titleKey="community.page.newPost" fallback="New post" locale={locale} />
