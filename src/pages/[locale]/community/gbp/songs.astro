---
import { staticBuildPaths } from "../../../../server/static-build";
import { providerCollectionData } from "../../../../server/provider-page-data";
import { renderProviderSongs } from "../../../../server/render-provider";
import { serializePageData } from "../../../../lib/page-data";
import { collectionDescription } from "../../../../lib/collection-description";
import Base from "../../../../layouts/Base.astro";
import AppShell from "../../../../components/AppShell.astro";
import { catalogConfig } from "../../../../config/catalog-labels";
import { LOCALES, type Locale } from "../../../../i18n/locales";
import { t } from "../../../../i18n/messages";
import "../../../../lit/catalog-screen";
import "../../../../styles/catalog.css";

export function getStaticPaths() {
  return staticBuildPaths("src/pages/[locale]/community/gbp/songs.astro", LOCALES.map((locale) => ({ params: { locale }, props: { locale } })));
}
const { locale } = Astro.props as { locale: Locale };
const route = "/community/gbp/songs";
const titleKey = "community.page.songsBestDori";
const title = t(locale, titleKey, "GBP songs");
const config = catalogConfig({ resource: "songs", locale, origin: "bestdori" });
const payload = await providerCollectionData("bestdori", locale, "songs");
const rendered = renderProviderSongs(config, payload, locale, route);
const pageDataId = "provider-collection";
const description = collectionDescription(Object.values(payload.document), locale, title);
---

<Base locale={locale} route={route} title={title} titleKey={titleKey} description={description}>
  <AppShell locale={locale} route={route} title={title} titleKey={titleKey} appBar={rendered.appBar}>
    <script is:inline type="application/json" id={pageDataId} set:html={serializePageData(payload)}></script>
    <catalog-screen config={config} data-page-data={pageDataId} data-prerendered set:html={rendered.body}></catalog-screen>
  </AppShell>
</Base>
<script>
  import "../../../../lit/catalog-screen";
</script>
