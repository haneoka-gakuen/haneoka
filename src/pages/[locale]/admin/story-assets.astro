---
import AdminDocument from "../../../components/AdminDocument.astro";
import {LOCALES,type Locale} from "../../../i18n/locales";
import {staticBuildPaths} from "../../../server/static-build";
export function getStaticPaths(){return staticBuildPaths("src/pages/[locale]/admin/story-assets.astro",LOCALES.map(locale=>({params:{locale},props:{locale}})));}
const {locale}=Astro.props as {locale:Locale};
---
<AdminDocument locale={locale} section="story-assets" />
