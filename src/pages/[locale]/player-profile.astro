---
import PlayerProfileDocument from "../../components/PlayerProfileDocument.astro";
import { LOCALES, type Locale } from "../../i18n/locales";
export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale }, props: { locale } }));
}
const { locale } = Astro.props as { locale: Locale };
---
<PlayerProfileDocument locale={locale} />
