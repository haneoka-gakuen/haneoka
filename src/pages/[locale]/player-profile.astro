---
import { staticBuildPaths } from "../../server/static-build";
import PlayerProfileDocument from "../../components/PlayerProfileDocument.astro";
import { LOCALES, type Locale } from "../../i18n/locales";
export function getStaticPaths() {
  return staticBuildPaths("src/pages/[locale]/player-profile.astro", LOCALES.map((locale) => ({ params: { locale }, props: { locale } })));
}
const { locale } = Astro.props as { locale: Locale };
---
<PlayerProfileDocument locale={locale} />
