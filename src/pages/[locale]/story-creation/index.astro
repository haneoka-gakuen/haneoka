---
import Base from "../../../layouts/Base.astro";
import AppShell from "../../../components/AppShell.astro";
import { LOCALES, type Locale } from "../../../i18n/locales";
import { t } from "../../../i18n/messages";
import "../../../styles/story-creation.css";
import { staticBuildPaths } from "../../../server/static-build";
import { readFileSync } from "node:fs";
import { createHash } from "node:crypto";
export function getStaticPaths(){ return staticBuildPaths("src/pages/[locale]/story-creation/index.astro",LOCALES.map(locale=>({params:{locale},props:{locale}}))); }
const {locale}=Astro.props as {locale:Locale};
const titleKey="community.stories.editor",title=t(locale,titleKey),route="/story-creation";
const studioVersion=createHash("sha256").update(readFileSync(new URL("../../../../.generated-public/story-studio/index.html",import.meta.url))).digest("hex").slice(0,16);
---
<Base locale={locale} route={route} title={title} titleKey={titleKey}>
 <AppShell locale={locale} route={route} title={title} titleKey={titleKey}>
  <story-creation-workspace class="story-creation" locale={locale} studio-entry={`/story-studio/index.html?v=${studioVersion}`} resource-origin={import.meta.env.PUBLIC_STORY_RESOURCE_ORIGIN||undefined}></story-creation-workspace>
 </AppShell>
</Base>
<script>import "../../../lit/story-creation-workspace";</script>
