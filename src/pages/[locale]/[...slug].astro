---
import RouteDocument from "../../components/RouteDocument.astro";
import SongSlidePuzzleDocument from "../../components/SongSlidePuzzleDocument.astro";
import StampMakerDocument from "../../components/StampMakerDocument.astro";
import { ROUTES, titleOf, type RouteDefinition } from "../../config/routes";
import { LOCALES, type Locale } from "../../i18n/locales";
import { resourceCollectionHref } from "../../lib/resource-route";

export function getStaticPaths() {
  return LOCALES.flatMap((locale) =>
    ROUTES.filter(
      (entry) =>
        ![
          "/",
          "/account",
          "/account/reset-password",
          "/settings",
        ].includes(entry.route) &&
        !entry.route.startsWith("/community") &&
        !resourceCollectionHref(entry.route, "intl", locale),
    ).map((entry) => {
      const slug = entry.route.replace(/^\/+/, "") || undefined;
      const title = titleOf(entry, locale);
      return { params: { locale, slug }, props: { locale, entry, title } };
    }),
  );
}
const { locale, entry, title } = Astro.props as { locale: Locale; entry: RouteDefinition; title: string };
if (entry.staticRedirect) return Astro.redirect(`/${locale}${entry.staticRedirect}/`, 308);
---
{entry.kind === "song-puzzle" ? (
  <SongSlidePuzzleDocument locale={locale} />
) : entry.kind === "stamp-maker" ? (
  <StampMakerDocument locale={locale} />
) : (
  <RouteDocument locale={locale} entry={entry} title={title} />
)}
