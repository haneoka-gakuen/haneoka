---
import { staticBuildPaths } from "../../server/static-build";
import Base from "../../layouts/Base.astro";
import AppShell from "../../components/AppShell.astro";
import SongProgressPage from "../../components/pages/SongProgressPage.astro";
import { LOCALES, type Locale } from "../../i18n/locales";
import { t } from "../../i18n/messages";
import { publicSongsPageData } from "../../server/tool-page-data";
import { renderSongProgressPage } from "../../server/render-tools";

export function getStaticPaths() {
  return staticBuildPaths("src/pages/[locale]/song-progress.astro", LOCALES.map((locale) => ({ params: { locale }, props: { locale } })));
}
const { locale } = Astro.props as { locale: Locale };
const route = "/song-progress";
const title = t(locale, "catalog.songProgress.title", "Song progress");
const page = await renderSongProgressPage(await publicSongsPageData("intl"), locale);
---

<Base locale={locale} route={route} title={title} titleKey="catalog.songProgress.title">
  <AppShell locale={locale} route={route} title={title} titleKey="catalog.songProgress.title" appBar={page.appBar}>
    <SongProgressPage locale={locale} />
  </AppShell>
</Base>
