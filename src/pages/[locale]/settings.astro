---
import { staticBuildPaths } from "../../server/static-build";
import SettingsDocument from "../../components/SettingsDocument.astro";
import { LOCALES, type Locale } from "../../i18n/locales";

export function getStaticPaths() {
  return staticBuildPaths("src/pages/[locale]/settings.astro", LOCALES.map((locale) => ({ params: { locale }, props: { locale } })));
}
const { locale } = Astro.props as { locale: Locale };
---
<SettingsDocument locale={locale} />
