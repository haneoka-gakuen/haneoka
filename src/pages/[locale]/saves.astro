---
import { staticBuildPaths } from "../../server/static-build";
import Base from "../../layouts/Base.astro";
import AppShell from "../../components/AppShell.astro";
import { LOCALES, type Locale } from "../../i18n/locales";
import { t } from "../../i18n/messages";
import "../../styles/save-workspace.css";
export function getStaticPaths(){return staticBuildPaths("src/pages/[locale]/saves.astro",LOCALES.map(locale=>({params:{locale},props:{locale}})));}
const {locale}=Astro.props as {locale:Locale};
const title=t(locale,"saveWorkspace.title");
const keys="title import loading failed back server saved unknown team export delete local empty native read cancel confirm".split(" ");
keys.push("_memberCards","_supportCards","_characters","_characterFriendships","_bandItems","_items","_liveMusicResults","_topHighScoreRatings","_challengeMusicResults","_events","_challengeLives","_gachaRecords","_storyEpisodeRecords","_decks","_normalMissions","_limitedMissions","_characterMissions","_playerSeasonPass","_monthlyPass","_receivedLoginBonuses","_unlockedCostumes","_currentCostumes","_backgrounds","_stamps","_degrees","_playerProfileCards","_liveLaneSkins","_liveNoteSkins","_liveNoteEffectSkins","_liveNoteSeGroups","_spots","_memory","_liveBoost","_liveSkip","_vip","_offlineBonus","_arenaLeagues","_liveMusics","_challengeMusics","_characterFriendshipRankRewards","_stampFavorites","_exchange","_shop","_exp","_playerRankUpData");
keys.push("catalogRetry","yes","no","id","level","experience","rank","training","liveSkill","performanceSkill","song","notCleared","name","_amount","_level","_exp","entry");
keys.push("noSave","tooLarge","timeout","field","clear","fullCombo","allPerfect","_count","_value","_name","_isLocked","_highScore","_playCount","_clearCount","_status","_isReceived","_isRead","_point","_score","_startAt","_endAt","_masterId","_id","_masterItemId","_masterCharacterId","_mLiveMusicId","_rank","_awakeCount","_liveSkillLevel","_performanceSkillLevel","_experience");
keys.push("workerFailed","storageFailed","fileUnreadable","invalidFile");
const messages=Object.fromEntries(keys.map(key=>[key,t(locale,`saveWorkspace.${key}`)]));
---
<Base locale={locale} route="/saves" title={title} titleKey="saveWorkspace.title">
 <AppShell locale={locale} route="/saves" title={title} titleKey="saveWorkspace.title">
  <save-workspace locale={locale} data-messages={JSON.stringify(messages)}></save-workspace>
 </AppShell>
</Base>
<script>import "../../lit/save-workspace";</script>
