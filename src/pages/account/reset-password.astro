---
import Base from "../../layouts/Base.astro";
import AppShell from "../../components/AppShell.astro";
import I18nText from "../../components/I18nText.astro";
import { DEFAULT_LOCALE } from "../../i18n/locales";
import { t } from "../../i18n/messages";
import "../../styles/account-settings.css";

const locale = DEFAULT_LOCALE;
const titleKey = "accountPage.resetPasswordTitle";
const title = t(locale, titleKey, "Reset password");
---
<Base locale={locale} route="/account/reset-password" title={title} titleKey={titleKey}>
  <AppShell locale={locale} route="/account/reset-password" title={title} titleKey={titleKey}>
    <section class="page page--compact account-page reset-password-page">
      <form class="surface surface--outlined reset-password-form" data-reset-form hidden>
        <header>
          <span class="workspace-card__icon"><svg class="material-icon" width="24" height="24"><use href="/icons.svg#key"></use></svg></span>
          <span>
            <h2><I18nText keyName="accountPage.resetPassword" fallback="Reset password" locale={locale} /></h2>
            <p><I18nText keyName="accountPage.passwordHint" fallback="Use a secure password of at least 12 characters." locale={locale} /></p>
          </span>
        </header>
        <label><I18nText keyName="accountPage.newPassword" fallback="New password" locale={locale} /><span class="field"><input name="new-password" type="password" autocomplete="new-password" minlength="12" maxlength="128" required /></span></label>
        <label><I18nText keyName="accountPage.confirmPassword" fallback="Confirm password" locale={locale} /><span class="field"><input name="confirm-password" type="password" autocomplete="new-password" minlength="12" maxlength="128" required /></span></label>
        <output class="inline-message" data-reset-message hidden></output>
        <button class="button" type="submit"><I18nText keyName="accountPage.resetPassword" fallback="Reset password" locale={locale} /></button>
      </form>
      <section class="surface surface--outlined reset-password-state" data-reset-invalid hidden>
        <svg class="material-icon" width="32" height="32"><use href="/icons.svg#link_off"></use></svg>
        <h2><I18nText keyName="accountPage.invalidResetLink" fallback="Invalid reset link" locale={locale} /></h2>
        <a class="button button--tonal" href="/account"><I18nText keyName="accountPage.backToSignIn" fallback="Back to sign in" locale={locale} /></a>
      </section>
      <section class="surface surface--outlined reset-password-state" data-reset-complete hidden>
        <svg class="material-icon" width="32" height="32"><use href="/icons.svg#check_circle"></use></svg>
        <h2><I18nText keyName="accountPage.passwordReset" fallback="Password reset" locale={locale} /></h2>
        <a class="button" href="/account"><I18nText keyName="accountPage.backToSignIn" fallback="Back to sign in" locale={locale} /></a>
      </section>
      <span hidden data-password-mismatch><I18nText keyName="accountPage.passwordMismatch" fallback="Passwords do not match" locale={locale} /></span>
      <span hidden data-auth-failed><I18nText keyName="accountPage.authFailed" fallback="Password reset failed" locale={locale} /></span>
    </section>
  </AppShell>
</Base>
<script>
  const form = document.querySelector<HTMLFormElement>("[data-reset-form]");
  const invalid = document.querySelector<HTMLElement>("[data-reset-invalid]");
  const complete = document.querySelector<HTMLElement>("[data-reset-complete]");
  const message = document.querySelector<HTMLOutputElement>("[data-reset-message]");
  const token = new URLSearchParams(location.search).get("token") || "";
  if (token) form?.removeAttribute("hidden");
  else invalid?.removeAttribute("hidden");
  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const password = String(data.get("new-password") || "");
    const confirmation = String(data.get("confirm-password") || "");
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (message) message.hidden = true;
    if (password !== confirmation) {
      if (message) {
        message.textContent = document.querySelector<HTMLElement>("[data-password-mismatch]")?.textContent || "Passwords do not match";
        message.hidden = false;
      }
      return;
    }
    if (button) button.disabled = true;
    try {
      const response = await fetch("/api/auth/reset-password", {
        method: "POST",
        credentials: "same-origin",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ newPassword: password, token }),
      });
      if (!response.ok) throw new Error(String(response.status));
      form.hidden = true;
      complete?.removeAttribute("hidden");
    } catch {
      if (message) {
        message.textContent = document.querySelector<HTMLElement>("[data-auth-failed]")?.textContent || "Password reset failed";
        message.hidden = false;
      }
    } finally {
      if (button) button.disabled = false;
    }
  });
</script>
<style>
  .reset-password-page { display: grid; place-items: start center; }
  .reset-password-form, .reset-password-state { width: min(100%, 640px); }
  .reset-password-form { display: grid; gap: 16px; }
  .reset-password-form > header { display: flex; gap: 12px; align-items: flex-start; }
  .reset-password-form h2, .reset-password-form p, .reset-password-state h2 { margin: 0; }
  .reset-password-form p { margin-top: 4px; color: var(--md-sys-color-on-surface-variant); }
  .reset-password-form label { display: grid; gap: 6px; }
  .reset-password-form .button { width: 100%; }
  .reset-password-state { justify-items: center; gap: 16px; text-align: center; }
</style>
