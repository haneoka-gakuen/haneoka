---
import { staticBuildPaths } from "../../../../server/static-build";
import AnonTokyoDocument from "../../../../components/AnonTokyoDocument.astro";
import { LOCALES, type Locale } from "../../../../i18n/locales";
import { RELEASE_SERVERS, type ReleaseServer } from "../../../../lib/release-server";
import { staticCatalogPageServers } from "../../../../lib/entity-graph";
import { ANON_TOKYO_MODES, type AnonTokyoMode } from "../../../../lib/resource-route";

export async function getStaticPaths() {
  // ANON TOKYO is not public yet: no pages are built until it is. Astro hoists
  // this function out of the frontmatter, so the switch has to live inside it.
  const anonTokyoPublic = false as boolean;
  const servers = anonTokyoPublic ? await staticCatalogPageServers() : [];
  return staticBuildPaths("src/pages/[server]/[locale]/anon-tokyo/[mode].astro", servers.flatMap((server) =>
    LOCALES.flatMap((locale) =>
      ANON_TOKYO_MODES.map((mode) => ({ params: { server, locale, mode }, props: { server, locale, mode } })),
    ),
  ));
}

const { server, locale, mode } = Astro.props as {
  server: ReleaseServer;
  locale: Locale;
  mode: AnonTokyoMode;
};
---

<AnonTokyoDocument locale={locale} mode={mode} server={server} />
