---
import CatalogEntityPage from "../../../../components/entities/CatalogEntityPage.astro";
import HelpEntityPage from "../../../../components/entities/HelpEntityPage.astro";
import Live2DEntityPage from "../../../../components/entities/Live2DEntityPage.astro";
import SpineEntityPage from "../../../../components/entities/SpineEntityPage.astro";
import StoryEntityPage from "../../../../components/entities/StoryEntityPage.astro";
import SkillEntityPage from "../../../../components/entities/SkillEntityPage.astro";
import { LOCALES, type Locale } from "../../../../i18n/locales";
import { isPublicReleaseServer, type ReleaseServer } from "../../../../lib/release-server";
import {
  entityHref,
  resourceKindForCollection,
  type EntityLink,
  type ResourceKind,
} from "../../../../lib/resource-route";
import { staticCatalogPageServers } from "../../../../lib/entity-graph";
import { searchableCatalogPages, type SearchableCatalogPage } from "../../../../lib/searchable-catalog";
import { searchableHelpPages, type SearchableHelpTopic } from "../../../../lib/searchable-help";
import { searchableModelPages, type SearchableModelPage } from "../../../../lib/searchable-models";
import { searchableStoryPages, type SearchableStoryPage } from "../../../../lib/searchable-stories";
import { skillCatalogPayload, skillPageId, type SkillCatalogPayload, type SkillCatalogEntry } from "../../../../server/skill-catalog";
import { resolveLocalizedText } from "../../../../lib/localized-text";

type SkillPage = { catalog: Omit<SkillCatalogPayload, "entries">; entry: SkillCatalogEntry };
type RouteProps = {
  server: ReleaseServer;
  locale: Locale;
  kind: ResourceKind;
  page: SearchableCatalogPage | SearchableModelPage | SearchableStoryPage | SearchableHelpTopic | SkillPage;
  previous?: EntityLink;
  next?: EntityLink;
};

export async function getStaticPaths() {
  const output: Array<{ params: Record<string, string>; props: RouteProps }> = [];
  for (const server of await staticCatalogPageServers(true)) {
    const [catalog, models, stories, help, skills] = await Promise.all([
      searchableCatalogPages(server),
      searchableModelPages(server),
      searchableStoryPages(server),
      searchableHelpPages(server),
      skillCatalogPayload(server),
    ]);
    const entries: Array<{
      kind: ResourceKind;
      id: string;
      title: Record<Locale, string>;
      page: RouteProps["page"];
      query?: Readonly<Record<string, string>>;
      group: string;
    }> = [];
    for (const page of catalog) {
      const kind = resourceKindForCollection(page.collection);
      if (kind)
        entries.push({
          kind,
          id: page.id,
          title: page.titles,
          page,
          group: `catalog:${page.collection}`,
        });
    }
    for (const page of models)
      entries.push({ kind: page.kind, id: page.id, title: page.titles, page, group: page.kind });
    for (const page of stories)
      entries.push({
        kind: "stories",
        id: page.storyId,
        title: page.titles,
        page,
        query: { mode: page.mode },
        group: `stories:${page.mode}`,
      });
    for (const page of help)
      entries.push({ kind: "help", id: page.id, title: page.titles, page, group: "help" });
    const { entries: skillEntries, ...skillCatalog } = skills;
    for (const entry of skillEntries)
      entries.push({
        kind: "skills",
        id: skillPageId(entry),
        title: Object.fromEntries(LOCALES.map((target) => [target, resolveLocalizedText(entry.name, target).text || entry.key])) as Record<Locale, string>,
        page: { catalog: skillCatalog, entry },
        group: `skills:${entry.cards.length ? "linked" : "unlinked"}`,
      });

    const groups = new Map<string, typeof entries>();
    for (const entry of entries) {
      const peers = groups.get(entry.group) ?? [];
      peers.push(entry);
      groups.set(entry.group, peers);
    }
    for (const locale of LOCALES) {
      for (const peers of groups.values()) {
      for (const [peerIndex, entry] of peers.entries()) {
        const previous = peers[peerIndex - 1];
        const next = peers[peerIndex + 1];
        output.push({
          params: { server, locale, kind: entry.kind, id: entry.id },
          props: {
            server,
            locale,
            kind: entry.kind,
            page: entry.page,
            previous: previous
              ? {
                  href: entityHref({
                    server,
                    locale,
                    kind: previous.kind,
                    id: previous.id,
                    query: previous.query,
                  }),
                  title: previous.title[locale],
                }
              : undefined,
            next: next
              ? {
                  href: entityHref({ server, locale, kind: next.kind, id: next.id, query: next.query }),
                  title: next.title[locale],
                }
              : undefined,
          },
        });
      }
      }
    }
  }
  return output;
}

const { server, locale, kind, page, previous, next } = Astro.props as RouteProps;
const rawReturnTo = Astro.url.searchParams.get("return") || "";
const returnTo = rawReturnTo.startsWith("/") && !rawReturnTo.startsWith("//") ? rawReturnTo : undefined;
const catalogPage = page as SearchableCatalogPage;
const modelPage = page as SearchableModelPage;
const storyPage = page as SearchableStoryPage;
const helpPage = page as SearchableHelpTopic;
const skillPage = page as SkillPage;
---

{kind === "live2d" && modelPage.kind === "live2d" && (
  <Live2DEntityPage page={modelPage} locale={locale} server={server} canonical returnTo={returnTo} previous={previous} next={next} />
)}
{kind === "spine" && modelPage.kind === "spine" && (
  <SpineEntityPage page={modelPage} locale={locale} server={server} canonical returnTo={returnTo} previous={previous} next={next} />
)}
{kind === "help" && (
  <HelpEntityPage topic={helpPage} locale={locale} server={server} canonical returnTo={returnTo} previous={previous} next={next} />
)}
{kind === "stories" && (
  <StoryEntityPage page={storyPage} locale={locale} server={server} canonical returnTo={returnTo} previous={previous} next={next} />
)}
{kind === "skills" && (
  <SkillEntityPage page={skillPage} locale={locale} canonical returnTo={returnTo} previous={previous} next={next} />
)}
{kind !== "live2d" && kind !== "spine" && kind !== "help" && kind !== "stories" && kind !== "skills" && (
  <CatalogEntityPage page={catalogPage} locale={locale} server={server} canonical returnTo={returnTo} previous={previous} next={next} />
)}
