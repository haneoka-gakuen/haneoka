---
import { staticBuildPaths } from "../../../../server/static-build";
import HelpDocument from "../../../../components/HelpDocument.astro";
import Live2DDocument from "../../../../components/Live2DDocument.astro";
import RouteDocument from "../../../../components/RouteDocument.astro";
import SpineDocument from "../../../../components/SpineDocument.astro";
import CommunityStoriesDocument from "../../../../components/CommunityStoriesDocument.astro";
import { findRoute, titleOf } from "../../../../config/routes";
import { LOCALES, type Locale } from "../../../../i18n/locales";
import { RELEASE_SERVERS, type ReleaseServer } from "../../../../lib/release-server";
import { staticCatalogPageServers } from "../../../../lib/entity-graph";
import { RESOURCE_KINDS, type ResourceKind } from "../../../../lib/resource-route";

const CATALOG_ROUTES: Readonly<Partial<Record<ResourceKind, string>>> = {
  characters: "/catalog/characters",
  songs: "/catalog/songs",
  "member-cards": "/catalog/member-cards",
  "support-cards": "/catalog/support-cards",
  comics: "/catalog/comics",
  stamps: "/catalog/stamps",
  stickers: "/catalog/stickers",
  backgrounds: "/catalog/backgrounds",
  "chat-customizations": "/catalog/chat-customizations",
  "band-items": "/catalog/band-items",
  items: "/catalog/items",
  events: "/catalog/events",
  arena: "/catalog/arena",
  "real-lives": "/catalog/real-lives",
  gacha: "/catalog/gacha",
  "login-campaigns": "/catalog/login-campaigns",
  shop: "/catalog/shop",
  exchange: "/catalog/exchange",
  circle: "/catalog/circle",
  challenge: "/catalog/challenge",
  passes: "/catalog/passes",
  "tgw-card": "/catalog/tgw-card",
  missions: "/catalog/missions",
};

export async function getStaticPaths() {
  return staticBuildPaths("src/pages/[server]/[locale]/[kind]/index.astro", (await staticCatalogPageServers()).flatMap((server) =>
    LOCALES.flatMap((locale) =>
      RESOURCE_KINDS.filter((kind) => kind !== "circle" && kind !== "challenge" && kind !== "skills" && kind !== "charts" && kind !== "stories")
        .map((kind) => ({ params: { server, locale, kind } })),
    ),
  ));
}

const { server, locale, kind } = Astro.params as {
  server: ReleaseServer;
  locale: Locale;
  kind: ResourceKind;
};
const catalogRoute = CATALOG_ROUTES[kind];
const catalogEntry = catalogRoute ? findRoute(catalogRoute) : undefined;
if (catalogRoute && !catalogEntry) throw new Error(`Missing route definition for ${catalogRoute}`);
---

{kind === "live2d" && <Live2DDocument locale={locale} server={server} />}
{kind === "spine" && <SpineDocument locale={locale} server={server} />}
{kind === "help" && <HelpDocument locale={locale} server={server} />}
{kind === "community-stories" && <CommunityStoriesDocument locale={locale} server={server} />}
{catalogEntry && <RouteDocument locale={locale} entry={catalogEntry} title={titleOf(catalogEntry, locale)} server={server} />}
