---
import RouteDocument from "../../../../components/RouteDocument.astro";
import { findRoute, titleOf } from "../../../../config/routes";
import { LOCALES, type Locale } from "../../../../i18n/locales";
import { RELEASE_SERVERS, type ReleaseServer } from "../../../../lib/release-server";
import { staticCatalogPageServers } from "../../../../lib/entity-graph";

export async function getStaticPaths() {
  return (await staticCatalogPageServers()).flatMap((server) => LOCALES.map((locale) => ({
    params: { server, locale }, props: { server, locale },
  })));
}
const { server, locale } = Astro.props as { server: ReleaseServer; locale: Locale };
const entry = findRoute("/catalog/events/tracker");
if (!entry) throw new Error("Missing event tracker route");
---

<RouteDocument locale={locale} server={server} entry={entry} title={titleOf(entry, locale)} canonicalRoute={`/${server}/${locale}/events/tracker/`} />
