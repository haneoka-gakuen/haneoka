---
import { staticBuildPaths } from "../../../../../server/static-build";
import CatalogEntityPage from "../../../../../components/entities/CatalogEntityPage.astro";
import { LOCALES, type Locale } from "../../../../../i18n/locales";
import { staticResourceServers } from "../../../../../lib/entity-graph";
import { isPublicReleaseServer, type ReleaseServer } from "../../../../../lib/release-server";
import { searchableCatalogPages, type SearchableCatalogPage } from "../../../../../lib/searchable-catalog";

type RouteProps = {
  server: ReleaseServer;
  locale: Locale;
  page: SearchableCatalogPage;
};

export async function getStaticPaths() {
  const output: Array<{ params: Record<string, string>; props: RouteProps }> = [];
  for (const server of staticResourceServers().filter(isPublicReleaseServer)) {
    const pages = await searchableCatalogPages(server);
    for (const page of pages) {
      if (page.collection !== "songs" || page.kind !== "song") continue;
      for (const locale of LOCALES) {
        output.push({
          params: { server, locale, id: page.id },
          props: { server, locale, page },
        });
      }
    }
  }
  return staticBuildPaths("src/pages/[server]/[locale]/songs/[id]/chart.astro", output);
}

const { server, locale, page } = Astro.props as RouteProps;
const rawReturnTo = Astro.url.searchParams.get("return") || "";
const returnTo = rawReturnTo.startsWith("/") && !rawReturnTo.startsWith("//") ? rawReturnTo : undefined;
---

<CatalogEntityPage
  page={page}
  locale={locale}
  server={server}
  canonical
  chartPage
  returnTo={returnTo}
/>
