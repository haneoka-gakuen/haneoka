---
import CommunityDocument from "../../components/CommunityDocument.astro";
/**
 * Community routes that <community-workspace> serves. Bestdori stories are
 * not among them: they render through <story-workspace> at
 * /community/stories-bestdori/{section}, one real route per section.
 */
export function getStaticPaths() { return [undefined, "feeds", "mine", "bookmarks", "notifications", "activity", "tags", "playlists"].map((path) => ({ params: { path }, props: { path } })); }
const { path } = Astro.props as { path?: string };
---
<CommunityDocument locale="ja" path={path} />
