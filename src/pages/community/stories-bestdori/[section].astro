---
/**
 * Bestdori stories, one route per section.
 *
 * These render through <story-workspace>, the same component as
 * /catalog/stories/*, with origin="bestdori". That is how the site worked
 * before the Astro rewrite: the Bestdori event/band/main catalogues went
 * through the archive's own shared story browser and only the data source
 * differed. It is also the only arrangement in which the two can be
 * guaranteed to look the same — there is one screen, so there is nothing to
 * diverge.
 *
 * What this replaces: a hand-rolled list inside <community-workspace> with
 * its own search field, its own count, its own tile markup and a pill tab bar
 * across the top for switching sections. The sections are routes; the sidebar
 * lists them; a page does not need a bar to navigate to itself.
 */
import Base from "../../../layouts/Base.astro";
import AppShell from "../../../components/AppShell.astro";
import { DEFAULT_LOCALE, type Locale } from "../../../i18n/locales";
import { t } from "../../../i18n/messages";
import "../../../lit/story-workspace";
import "../../../styles/catalog.css";
import "../../../styles/story.css";

/** The sections the Bestdori worker can serve. */
export const BESTDORI_STORY_SECTIONS = ["event", "band", "main", "afterlive", "card"] as const;

export function getStaticPaths() {
  return BESTDORI_STORY_SECTIONS.map((section) => ({ params: { section }, props: { section } }));
}

const { section } = Astro.props as { section: string };
const locale = DEFAULT_LOCALE as Locale;
const route = `/community/stories-bestdori/${section}`;
const titleKey = `storyNavigation.bestdori${section.charAt(0).toUpperCase()}${section.slice(1)}`;
const title = t(locale, titleKey, section);
---

<Base locale={locale} route={route} title={title} titleKey={titleKey} description={title}>
  <AppShell locale={locale} route={route} title={title} titleKey={titleKey}>
    <story-workspace locale={locale} mode={section} origin="bestdori"></story-workspace>
  </AppShell>
</Base>
<script>
  import "../../../lit/story-workspace";
</script>
