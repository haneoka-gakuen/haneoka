---
/**
 * Bestdori songs.
 *
 * The community mirror of the song catalogue. Its worker projection
 * (worker/bestdori.ts → `baseSong`) emits the same record shape as the
 * release catalogue — musicId, musicTitle, bandId, jacketUrl, difficulty,
 * musicUrl — so this route renders through the same <catalog-screen> as
 * /catalog/songs rather than the hand-rolled list the community workspace
 * used to draw. One presentation, two origins: the grid, the table, the
 * filters, the sorting, the player hand-off and the chart viewer all come
 * for free and cannot drift from the catalogue's.
 */
import Base from "../../layouts/Base.astro";
import AppShell from "../../components/AppShell.astro";
import { catalogConfig } from "../../config/catalog-labels";
import { DEFAULT_LOCALE } from "../../i18n/locales";
import { t } from "../../i18n/messages";
import "../../lit/catalog-screen";
import "../../styles/catalog.css";

const locale = DEFAULT_LOCALE;
const route = "/community/songs-bestdori";
const titleKey = "communityPage.songsBestDori";
const title = t(locale, titleKey, "GBP songs");
const config = catalogConfig({ resource: "songs", locale, origin: "bestdori" });
---

<Base locale={locale} route={route} title={title} titleKey={titleKey} description={title}>
  <AppShell locale={locale} route={route} title={title} titleKey={titleKey}>
    <catalog-screen config={config}></catalog-screen>
  </AppShell>
</Base>
<script>
  import "../../lit/catalog-screen";
</script>
