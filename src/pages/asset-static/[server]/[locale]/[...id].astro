---
import { staticBuildPaths } from "../../../../server/static-build";
import AssetsDocument from "../../../../components/AssetsDocument.astro";
import { assetStaticPaths } from "../../../../server/asset-page-data";
import { assetStaticLocation } from "../../../../lib/asset-static-routing";
export async function getStaticPaths() {
  return staticBuildPaths("src/pages/asset-static/[server]/[locale]/[...id].astro", await assetStaticPaths());
}
const location = assetStaticLocation(Astro.params.server, Astro.params.locale, Astro.params.id?.replace(/\.html$/u, "") || "");
if (!location) throw new Error("Invalid asset static document");
---
<AssetsDocument locale={location.locale} server={location.server} path={location.path} selected={location.selected} />
