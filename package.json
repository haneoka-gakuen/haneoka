{
  "name": "haneoka",
  "private": true,
  "description": "Unofficial BanG Dream! Our Notes database, resource archive and browser tools",
  "keywords": [
    "bang-dream",
    "our-notes",
    "resource-archive",
    "astro",
    "sonolus",
    "bang-dream-our-notes",
    "game-database",
    "song-database",
    "card-database",
    "story-archive",
    "chart-editor",
    "live2d-viewer",
    "spine-viewer",
    "bestdori"
  ],
  "license": "MPL-2.0",
  "homepage": "https://haneoka.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haneoka-gakuen/haneoka.git"
  },
  "bugs": {
    "url": "https://github.com/haneoka-gakuen/haneoka/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.14.0",
  "type": "module",
  "scripts": {
    "dependencies:checkout": "node scripts/external-repositories.mjs checkout",
    "dependencies:verify": "node scripts/external-repositories.mjs verify",
    "dependencies:update": "node scripts/external-repositories.mjs update && pnpm install --lockfile-only",
    "runtime:cubism:provision": "node scripts/cubism-runtime.mjs provision",
    "runtime:cubism:verify": "node scripts/cubism-runtime.mjs verify",
    "runtime:cubism:verify-output": "node scripts/cubism-runtime.mjs verify-output",
    "runtime:cubism:source-path": "node scripts/cubism-runtime.mjs source-path",
    "build:dependencies": "pnpm --recursive --workspace-concurrency=2 --filter @haneoka/i18n --filter @haneoka/cassiopeia --filter @haneoka/cassiopeia-plugin-our-notes --filter @haneoka/cassiopeia-renderer-three --filter @haneoka/cassiopeia-host-web --filter @haneoka/cassiopeia-ui-vue --filter @haneoka/cassiopeia-plugin-sonolus --filter @haneoka/game-data-exporter --filter @haneoka/vega-protocol --filter @haneoka/vega --filter @haneoka/vega-plugin-richtext --filter @haneoka/vega-ui-portable --filter @haneoka/vega-renderer-three --filter @haneoka/vega-plugin-haneoka --filter @haneoka/vega-theme-haneoka --filter @haneoka/vega-shell-default --filter @haneoka/vega-plugin-cubism --filter @haneoka/bestdori exec node -e \"require('node:child_process').execFileSync(process.platform==='win32'?'pnpm.cmd':'pnpm',['run',process.env.PNPM_PACKAGE_NAME==='@haneoka/vega'?'build:core':'build'],{stdio:'inherit',shell:process.platform==='win32'})\"",
    "build:packages": "pnpm --recursive --workspace-concurrency=2 --filter @haneoka/i18n --filter @haneoka/cassiopeia --filter @haneoka/cassiopeia-plugin-our-notes --filter @haneoka/cassiopeia-renderer-three --filter @haneoka/cassiopeia-host-web --filter @haneoka/cassiopeia-ui-vue --filter @haneoka/cassiopeia-plugin-sonolus --filter @haneoka/game-data-exporter --filter @haneoka/vega-protocol --filter @haneoka/vega --filter @haneoka/vega-plugin-richtext --filter @haneoka/vega-ui-portable --filter @haneoka/vega-renderer-three --filter @haneoka/vega-plugin-haneoka --filter @haneoka/vega-theme-haneoka --filter @haneoka/vega-shell-default --filter @haneoka/vega-plugin-cubism --filter @haneoka/bestdori --filter @haneoka/api-client --filter @haneoka/embed-core --filter @haneoka/cassiopeia-plugin-sekai --filter @haneoka/design-tokens --filter @haneoka/chart-editor --filter @haneoka/sonolus-core --filter @haneoka/sonolus exec node -e \"require('node:child_process').execFileSync(process.platform==='win32'?'pnpm.cmd':'pnpm',['run',process.env.PNPM_PACKAGE_NAME==='@haneoka/vega'?'build:core':'build'],{stdio:'inherit',shell:process.platform==='win32'})\"",
    "tokens:schemes": "pnpm --filter @haneoka/design-tokens generate",
    "prepare:frontend": "node scripts/build/team-builder-engine.mjs && node scripts/build/prepare-fonts.mjs && python3 scripts/build/icon_sprite.py --output .generated-public/icons.svg && node scripts/build/chart-image-fonts.mjs && node scripts/build/stamp-maker-fonts.mjs && node scripts/build/calendar-static-assets.mjs --prepare",
    "finalize:frontend": "node scripts/build/finalize-frontend.mjs",
    "build": "pnpm runtime:cubism:provision && pnpm build:packages && pnpm build:frontend && pnpm runtime:cubism:verify-output",
    "dev": "pnpm prepare:frontend && astro dev",
    "preview": "node server/preview.ts",
    "dev:worker": "wrangler dev --local-upstream localhost --ip 127.0.0.1 --port 8787",
    "db:schema:snapshot:local": "node scripts/database/snapshot_schema.ts --local",
    "db:schema:snapshot:remote": "node scripts/database/snapshot_schema.ts --remote",
    "db:schema:bootstrap:local": "wrangler d1 execute haneoka-community --local --file=worker/database/schema.sql",
    "db:admin:grant": "node scripts/database/grant_admin.ts",
    "db:plan:create": "node scripts/database/create_plan.ts",
    "db:plan:apply:local": "node scripts/database/apply_plan.ts --local",
    "pipeline": "python3 scripts/pipeline.py",
    "resources:story:catalog": "python3 scripts/pipeline.py --server jp-cbt build-api",
    "resources:story:release": "python3 scripts/pipeline.py --server jp-cbt build-release",
    "types:worker": "wrangler types worker/worker-configuration.d.ts --env-file .dev.vars.example",
    "types:worker:check": "wrangler types worker/worker-configuration.d.ts --env-file .dev.vars.example --check",
    "typecheck:tools": "tsc -p tsconfig.tools.json && tsc -p server/tsconfig.json && tsc -p packages/sonolus/tsconfig.tools.json && tsc -p .dependencies/sonolus-our-notes/tsconfig.tools.json",
    "typecheck:worker": "tsc -p worker/tsconfig.json",
    "typecheck": "pnpm build:packages && astro check && pnpm --filter @haneoka/design-tokens typecheck && pnpm --filter @haneoka/chart-editor typecheck && pnpm --filter @haneoka/vega typecheck && pnpm --filter @haneoka/vega-plugin-richtext typecheck && pnpm --filter @haneoka/vega-ui-portable typecheck && pnpm --filter @haneoka/vega-renderer-three typecheck && pnpm --filter @haneoka/vega-theme-haneoka typecheck && pnpm --filter @haneoka/vega-shell-default typecheck && pnpm --filter @haneoka/vega-plugin-cubism typecheck && pnpm --filter @haneoka/vega-plugin-haneoka typecheck && pnpm --filter @haneoka/bestdori typecheck && pnpm --filter @haneoka/sonolus-core typecheck && pnpm --filter @haneoka/sonolus typecheck && pnpm typecheck:tools && pnpm typecheck:downloads && pnpm typecheck:worker && pnpm types:worker:check",
    "lint": "pnpm lint:frontend && pnpm lint:services && pnpm lint:packages && pnpm lint:sonolus",
    "lint:frontend": "astro check",
    "lint:services": "eslint worker server scripts",
    "lint:packages": "eslint packages/*/src packages/*/vite.config.ts",
    "lint:sonolus": "eslint packages/sonolus/scripts",
    "format": "prettier --write package.json pnpm-workspace.yaml \"src/**/*.{ts,css}\" astro.config.mjs eslint.config.mjs \"worker/*.{ts,json}\" \"server/**/*.ts\" \"scripts/**/*.{ts,mjs}\" \"packages/*/src/**/*.{ts,tsx,vue,css,json}\" \"packages/*/*.{ts,json}\" \"packages/sonolus/{src,scripts}/**/*.ts\"",
    "format:check": "prettier --check package.json pnpm-workspace.yaml \"src/**/*.{ts,css}\" astro.config.mjs eslint.config.mjs \"worker/*.{ts,json}\" \"server/**/*.ts\" \"scripts/**/*.{ts,mjs}\" \"packages/*/src/**/*.{ts,tsx,vue,css,json}\" \"packages/*/*.{ts,json}\" \"packages/sonolus/{src,scripts}/**/*.ts\"",
    "sonolus:release": "node packages/sonolus/scripts/build-native-sound-assets.ts && node packages/sonolus/scripts/build-original-assets.ts && pnpm sonolus:release:prepared",
    "sonolus:payload": "node packages/sonolus/scripts/build-native-sound-assets.ts && node packages/sonolus/scripts/build-original-assets.ts && pnpm sonolus:payload:prepared",
    "sonolus:build": "pnpm sonolus:engine && pnpm sonolus:payload",
    "build:embeds": "node scripts/build-embeds.mjs --regenerate",
    "build:frontend": "pnpm prepare:frontend && pnpm build:embeds && pnpm build:provider-static && astro build && pnpm finalize:frontend",
    "sonolus:engine": "SONOLUS_BUILD_JOBS=1 SONOLUS_COMPILER_WORKERS=1 pnpm --filter @haneoka/sonolus-our-notes build",
    "sonolus:release:prepared": "node packages/sonolus/scripts/build-worker-assets.ts",
    "sonolus:payload:prepared": "SONOLUS_ENGINE_ONLY=1 SONOLUS_OUTPUT_DIR=data/sonolus/current node packages/sonolus/scripts/build-worker-assets.ts",
    "build:standalone-tools": "pnpm --filter @haneoka/cassiopeia-plugin-sekai build && pnpm --filter @haneoka/altair-plugin-sandbox build",
    "build:provider-static": "node scripts/build/provider-static.mjs",
    "typecheck:downloads": "tsc -p worker/tsconfig.downloads.json",
    "types:downloads": "wrangler types worker/downloads-configuration.d.ts --config wrangler.downloads.jsonc --env-interface DownloadEnv",
    "types:downloads:check": "wrangler types worker/downloads-configuration.d.ts --config wrangler.downloads.jsonc --env-interface DownloadEnv --check"
  },
  "dependencies": {
    "@bbob/parser": "catalog:",
    "@cloudflare/containers": "catalog:",
    "@esotericsoftware/spine-threejs": "catalog:",
    "@fontsource-variable/noto-sans": "catalog:",
    "@fontsource-variable/noto-sans-jp": "catalog:",
    "@fontsource-variable/noto-sans-kr": "catalog:",
    "@fontsource-variable/noto-sans-sc": "catalog:",
    "@fontsource-variable/noto-sans-tc": "catalog:",
    "@fontsource-variable/roboto": "catalog:",
    "@haneoka/bestdori": "workspace:*",
    "@haneoka/cassiopeia": "workspace:*",
    "@haneoka/cassiopeia-host-web": "workspace:*",
    "@haneoka/cassiopeia-plugin-our-notes": "workspace:*",
    "@haneoka/cassiopeia-plugin-sekai": "workspace:*",
    "@haneoka/cassiopeia-renderer-three": "workspace:*",
    "@haneoka/cassiopeia-ui-vue": "workspace:*",
    "@haneoka/chart-editor": "workspace:*",
    "@haneoka/design-tokens": "workspace:*",
    "@haneoka/embed-core": "workspace:*",
    "@haneoka/game-data-exporter": "workspace:*",
    "@haneoka/i18n": "workspace:*",
    "@haneoka/sonolus": "workspace:*",
    "@haneoka/sonolus-core": "workspace:*",
    "@haneoka/vega": "workspace:*",
    "@haneoka/vega-protocol": "workspace:*",
    "@haneoka/vega-plugin-cubism": "workspace:*",
    "@haneoka/vega-plugin-haneoka": "^0.1.0",
    "@haneoka/vega-plugin-richtext": "workspace:*",
    "@haneoka/vega-renderer-three": "workspace:*",
    "@haneoka/vega-shell-default": "workspace:*",
    "@haneoka/vega-theme-haneoka": "workspace:*",
    "@haneoka/vega-ui-portable": "workspace:*",
    "@lit-labs/ssr": "catalog:",
    "@lit-labs/ssr-client": "catalog:",
    "@material/web": "^2.5.0",
    "@noble/ciphers": "catalog:",
    "@resvg/resvg-wasm": "2.6.2",
    "@thesvg/icons": "3.2.6",
    "@tiptap/core": "catalog:",
    "@tiptap/extension-highlight": "catalog:",
    "@tiptap/extension-text-align": "catalog:",
    "@tiptap/pm": "catalog:",
    "@tiptap/starter-kit": "catalog:",
    "@yume-chan/adb": "catalog:",
    "@yume-chan/adb-daemon-webusb": "catalog:",
    "astro": "^5.12.0",
    "better-auth": "catalog:",
    "circle-flags": "2.8.3",
    "echarts": "catalog:",
    "fflate": "catalog:",
    "lit": "^3.3.3",
    "lit-html": "3.3.3",
    "parse5": "catalog:",
    "photoswipe": "catalog:",
    "sql.js": "catalog:",
    "three": "catalog:",
    "@haneoka/render-shaders": "workspace:*"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@fontsource/material-symbols-rounded": "catalog:",
    "@iconify-json/material-symbols": "catalog:",
    "@material/material-color-utilities": "0.3.0",
    "@sinclair/typebox": "catalog:",
    "@sonolus/core": "catalog:",
    "@sonolus/express": "catalog:",
    "@sonolus/free-pack": "catalog:",
    "@types/express": "catalog:",
    "@types/http-cache-semantics": "4.2.0",
    "@types/node": "catalog:",
    "@types/sql.js": "catalog:",
    "@types/three": "catalog:",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "express": "catalog:",
    "http-cache-semantics": "4.2.0",
    "multer": "catalog:",
    "pagefind": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "wrangler": "catalog:"
  }
}
