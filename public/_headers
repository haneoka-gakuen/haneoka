# The sprite keeps a stable URL, so always revalidate it while the service
# worker serves the previous response immediately on repeat visits.
/icons.svg
  Cache-Control: public, max-age=0, must-revalidate, stale-while-revalidate=604800

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/build.json
  Cache-Control: no-store

/images/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

# Astro assets are content-hashed and immutable.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Fontsource's unicode-range shards keep a page from downloading an entire
# CJK family. The paths are stable within the locked dependency release.
/fonts/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

/tools/*
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS
  Cache-Control: public, max-age=0, must-revalidate

# The Cubism/Live2D core scripts, the haneoka cubism runtime build and the
# Basis transcoder come from locked dependencies behind stable paths, like the
# fonts: a month of freshness, then serve stale while one request refreshes.
/Core/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800
/cubism-runtime/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800
/basis/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

/manifest.webmanifest
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Build-time entity payloads are content-addressed by their hash.
/entity-data/v1/*
  Cache-Control: public, max-age=31536000, immutable

/playback-data/v1/*
  Cache-Control: public, max-age=31536000, immutable

/public-media/*
  Cache-Control: public, max-age=31536000, immutable

# Public standalone embed modules and their bundled assets allow external imports.
/embed/*
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS
  Access-Control-Expose-Headers: Content-Encoding, ETag, Accept-Ranges, Content-Range
/embed/*.js
  Content-Type: text/javascript; charset=utf-8
/embed/*.mjs
  Content-Type: text/javascript; charset=utf-8
/embed/*.css
  Content-Type: text/css; charset=utf-8
/embed/*.json
  Content-Type: application/json; charset=utf-8
/embed/*.glsl
  Content-Type: text/plain; charset=utf-8
/embed/*.woff2
  Content-Type: font/woff2
/embed/*.woff
  Content-Type: font/woff
/embed/*.ttf
  Content-Type: font/ttf
/embed/*.otf
  Content-Type: font/otf
/embed/*.wasm
  Content-Type: application/wasm

# A public resource site: every static file is readable from any origin.
/*
  Access-Control-Allow-Origin: *
